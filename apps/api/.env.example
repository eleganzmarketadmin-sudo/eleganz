# Copier ce fichier en `.env` (jamais commité — voir .gitignore) et remplir
# les vraies valeurs. En hébergement (Railway), ces mêmes clés se saisissent
# dans les variables d'environnement du service, pas dans un fichier.

# Base de données (fournie automatiquement par Railway si vous utilisez son
# add-on PostgreSQL — sinon l'URL de connexion complète).
DATABASE_URL="postgresql://user:password@host:5432/eleganz"

# Secret de signature des jetons JWT — une vraie valeur aléatoire longue en
# production, jamais la valeur de secours codée en dur utilisée en dev local.
JWT_SECRET="change-me-to-a-long-random-value"

# Port d'écoute de l'API (Railway le fournit automatiquement, inutile de le
# fixer soi-même en hébergement).
PORT=3001

# Stockage objet des images produits (Cloudflare R2, compatible S3 — voir
# docs/MAINTENANCE.md). Les 3 premières valeurs viennent de Cloudflare
# (R2 → Manage R2 API Tokens) ; R2_BUCKET est le nom du bucket créé
# (ex. "eleganz-produits") ; R2_PUBLIC_BASE_URL est l'URL publique du bucket
# (domaine R2.dev activé, ou domaine personnalisé une fois branché).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="eleganz-produits"
# Valeur réelle du bucket de production (accès public activé le 12 octobre 2026) :
R2_PUBLIC_BASE_URL="https://pub-dbe6a32776c04cb89956a0fc93095238.r2.dev"

# Compte administrateur ELEGANZ — utilisé seulement par le script de seed
# (pnpm --filter @eleganz/database seed:admin), jamais lu par l'API elle-même.
ELEGANZ_ADMIN_EMAIL="eleganzmarket.admin@gmail.com"
ELEGANZ_ADMIN_PASSWORD=""
