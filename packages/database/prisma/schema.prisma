// ELEGANZ — schéma de données unifié (ELEGANZ Gestion + ELEGANZ Marketplace)
// Choix d'architecture : PostgreSQL, accédé via Prisma depuis l'API NestJS.
// Voir /docs/DATABASE.md pour la justification de chaque bloc.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// PARAMÈTRES PLATEFORME — coordonnées officielles ELEGANZ (prompt du
// 12 oct. 2026), modifiables depuis le Centre de pilotage sans toucher au
// code. Table singleton : une seule ligne, id fixe "platform".
// ---------------------------------------------------------------------------

model PlatformSettings {
  id            String  @id @default("platform")
  address       String?
  website       String?
  supportEmail  String?
  supportPhone  String? // numéro de contact (peut aussi servir pour WhatsApp si identique)
  whatsappLink  String?
  telegramLink  String?
  tiktokUrl     String?
  instagramUrl  String?

  // Fonctionnalités IA "prévues mais inactives" (demande du 12 oct. 2026) :
  // le code et les points d'entrée existent déjà dans l'écran (bouton
  // visible mais désactivé, "Bientôt disponible"), mais restent coupés tant
  // qu'aucun fournisseur n'est choisi ET payé — ni Claude, qui ne fait ni
  // comparaison d'image ni génération d'image/vidéo, ni un budget engagé.
  // L'admin pourra les activer lui-même ici une fois le fournisseur branché,
  // sans redéploiement, en fonction des recettes/de la croissance.
  photoSearchEnabled Boolean @default(false)
  adStudioEnabled    Boolean @default(false)

  // Tarification de l'espace livreur (prompt du 13 oct. 2026, point 1) —
  // frais d'ouverture à la souscription + abonnement mensuel, tous deux
  // paramétrables depuis le Centre de pilotage, avec un nombre de mois de
  // gratuité décompté à partir de la validation (vérification admin) de
  // l'inscription du livreur. Valeurs de départ demandées : 10 $ à la
  // souscription, 5 $/mois, 8 mois gratuits.
  driverOpeningFee   Decimal  @default(10) @db.Decimal(12, 2)
  driverMonthlyFee   Decimal  @default(5)  @db.Decimal(12, 2)
  driverFreeMonths   Int      @default(8)

  // Tarification d'ELEGANZ Mon Comptable (prompt du 13 oct. 2026, §14) —
  // 6 mois gratuits à compter de la première activation effective, puis
  // 1 $/mois ou 10 $/an, entièrement paramétrable depuis le Centre de
  // pilotage sans redéploiement.
  comptableMonthlyFee Decimal @default(1)  @db.Decimal(12, 2)
  comptableYearlyFee  Decimal @default(10) @db.Decimal(12, 2)
  comptableFreeMonths Int     @default(6)

  // Taux de change système CDF/USD (prompt du 13 oct. 2026, point 5) — un
  // seul taux pour toute la plateforme, géré uniquement depuis le Centre de
  // pilotage. Nullable tant qu'aucun admin ne l'a configuré : tant qu'il est
  // vide, aucun équivalent de devise ne s'affiche nulle part plutôt que
  // d'inventer une valeur de départ. Phase 1 (affichage courant uniquement,
  // voir docs/PROJECT_STATUS.md) : converti "au taux du jour", jamais figé
  // rétroactivement sur une vente/opération déjà enregistrée — c'est
  // exchangeRateUpdatedAt + ExchangeRateHistory qui permettent de savoir
  // quel taux était affiché à quel moment, pas une conversion a posteriori
  // des montants déjà enregistrés.
  cdfPerUsd             Decimal?  @db.Decimal(14, 4)
  exchangeRateUpdatedAt DateTime?

  updatedAt     DateTime @updatedAt
}

// Historique des changements du taux de change système (prompt du 13 oct.
// 2026, point 5) — append-only, jamais modifié ni supprimé. Sert à répondre
// à "quel taux était affiché à telle date", notamment utile le jour où une
// phase 2 voudra figer le taux sur chaque transaction au lieu de toujours
// utiliser le taux courant (voir note sur PlatformSettings.cdfPerUsd).
model ExchangeRateHistory {
  id          String   @id @default(uuid())
  cdfPerUsd   Decimal  @db.Decimal(14, 4)
  setAt       DateTime @default(now())
  setByUserId String?

  @@index([setAt])
}

// ---------------------------------------------------------------------------
// IDENTITÉ & ACCÈS
// ---------------------------------------------------------------------------

enum UserRole {
  BUYER
  SHOP_OWNER
  SHOP_STAFF // gérant, caissier, magasinier, comptable — précisé par StaffRole
  DRIVER
  ADMIN_SUPER
  ADMIN_SALES
  ADMIN_FINANCE
  ADMIN_OPS
  ADMIN_LOGISTICS
  ADMIN_MARKETING
  ADMIN_SUPPORT
  ADMIN_AUDITOR
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  STOCK_KEEPER
  SALES_LEAD
  ACCOUNTANT
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  phone         String?  @unique
  passwordHash  String?
  role          UserRole
  fullName      String
  locale        String   @default("fr")
  // Support admin (prompt du 12 oct. 2026, "Centre de pilotage" — gestion
  // des comptes utilisateurs) : un admin peut bloquer la connexion d'un
  // compte posant problème, sans jamais supprimer ses données.
  isSuspended   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shopMemberships ShopStaff[]
  ownedShops      Shop[]        @relation("ShopOwner")
  orders          Order[]
  posSales        PosSale[]     @relation("CashierSales")
  driverProfile   Driver?
  addresses       Address[]
  auditLogs       AuditLog[]
  reviews         Review[]
  comptableSubscription  ComptableSubscription?
  comptableActivities    ComptableActivity[]
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  commune     String?
  quartier    String?
  avenue      String?
  repere      String? // point de repère, utile à Kinshasa
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
}

// ---------------------------------------------------------------------------
// BOUTIQUES — cœur du modèle "3 modes" (privée / marketplace / hybride)
// ---------------------------------------------------------------------------

enum ShopMode {
  PRIVATE    // ELEGANZ Gestion uniquement, rien de publié
  MARKETPLACE // vente en ligne uniquement
  HYBRID     // gestion physique + vente en ligne, stock unifié
}

enum ShopStatus {
  PENDING_VALIDATION
  FREE_PERIOD
  ACTIVE
  PAYMENT_DUE
  SUSPENDED
  CLOSED
}

model Shop {
  id               String     @id @default(uuid())
  ownerId          String
  owner            User       @relation("ShopOwner", fields: [ownerId], references: [id])
  name             String
  slug             String     @unique
  mode             ShopMode   @default(PRIVATE)
  status           ShopStatus @default(PENDING_VALIDATION)

  // Marketplace : visibilité publique
  isPubliclyListed Boolean    @default(false)

  // Identité affichée sur les documents imprimés (factures, bons de
  // livraison, tickets...) — personnalisable par chaque boutique (prompt
  // du 12 oct. 2026). Tous facultatifs : une boutique qui ne les renseigne
  // pas voit simplement son document sans cette ligne, jamais une valeur
  // inventée à sa place.
  invoiceAddress    String?
  invoicePhone      String?
  invoiceLogoUrl    String?
  invoiceFooterNote String? // ex. "Merci pour votre achat !", conditions de retour, etc.

  // Décision #9 (docs/COMPLIANCE_FACTURE_NORMALISEE.md) : les deux formats
  // de facture (homologuée DGI et non homologuée) doivent être proposables
  // au choix dès le départ, mais une boutique ne peut émettre une facture
  // fiscale homologuée qu'une fois ce champ activé manuellement par un
  // administrateur ELEGANZ, après vérification réelle de son homologation.
  fiscalHomologationConfirmed Boolean @default(false)

  // Identité fiscale de l'entreprise (Finance & Comptabilité, 13 oct. 2026,
  // §5.1) — tous facultatifs et vides par défaut : rien n'est présumé pour
  // une boutique qui ne les a pas renseignés, et aucune valeur n'est
  // déduite automatiquement d'un autre champ.
  fiscalLegalName       String?
  fiscalLegalForm       String?
  fiscalIdNumber        String?
  fiscalAddress         String?
  fiscalJurisdiction    String?
  fiscalRegime          String?
  fiscalExercice        String? // ex. "01/01-31/12"
  fiscalVatRegistered   Boolean @default(false)

  // Monétisation — champs admin-configurables, aucune valeur figée dans le code
  freeTrialStartedAt   DateTime?
  freeTrialDurationDays Int      @default(90) // décision #3 : 3 mois par défaut, modifiable en admin
  openingFeeWaived     Boolean  @default(true) // vrai tant que la phase gratuite est active
  openingFeePaidAt     DateTime?

  marketplaceBouquetId String?
  marketplaceBouquet    SubscriptionPlan? @relation("MarketplaceBouquet", fields: [marketplaceBouquetId], references: [id])
  gestionBouquetId      String?
  gestionBouquet         SubscriptionPlan? @relation("GestionBouquet", fields: [gestionBouquetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff          ShopStaff[]
  products       Product[]
  stockMovements StockMovement[]
  posSales       PosSale[]
  orders         ShopOrder[]
  invoices       CommercialDocument[]
  suppliers      Supplier[]
  expenses       Expense[]
  customers      ShopCustomer[]
  subscriptions  ShopSubscription[]
  platformInvoices Invoice[]
  creditWallet   AiCreditWallet?
  auditLogs      AuditLog[]
  reviews        Review[]
  variantOptions VariantOption[]
  shopDrivers    ShopDriver[]
  fiscalRules    FiscalRule[]
  accounts       Account[]
  journals       Journal[]
  journalEntries JournalEntry[]
  assets         Asset[]
}

model ShopStaff {
  id       String    @id @default(uuid())
  shopId   String
  shop     Shop      @relation(fields: [shopId], references: [id])
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  role     StaffRole
  active   Boolean   @default(true)
  createdAt DateTime @default(now())

  @@unique([shopId, userId])
}

// ---------------------------------------------------------------------------
// CATALOGUE & STOCK — commun aux ventes physiques et en ligne
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  name        String
  description String?
  category    String?
  images      String[] // URLs stockage objet
  isPublished Boolean  @default(false) // bascule "Publier sur ELEGANZ"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants Variant[]
  reviews  Review[]
}

enum VariantOptionKind {
  SIZE
  COLOR
}

// Valeurs prédéfinies de taille/couleur propres à chaque boutique (demande
// du 12 oct. 2026) — remplace la saisie libre par une liste déroulante à
// choix multiple côté catalogue, pour éviter les doublons dus à des fautes
// de frappe ("Rouge" / "rouge " / "ROUGE"). Chaque boutique construit sa
// propre liste au fil de l'eau ; aucune valeur n'est imposée globalement.
model VariantOption {
  id        String            @id @default(uuid())
  shopId    String
  shop      Shop              @relation(fields: [shopId], references: [id])
  kind      VariantOptionKind
  value     String
  createdAt DateTime          @default(now())

  @@unique([shopId, kind, value])
}

model Variant {
  id          String  @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  sku         String  @unique
  size        String?
  color       String?
  costPrice   Decimal? @db.Decimal(12, 2) // prix d'achat — jamais exposé aux autres vendeurs
  sellPrice   Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD") // USD ou CDF
  stockQty    Int      @default(0)
  lowStockAt  Int      @default(3)

  stockMovements StockMovement[]
  saleLines      PosSaleLine[]
  orderLines     OrderLine[]
}

enum StockMovementType {
  PURCHASE_IN
  POS_SALE_OUT
  ONLINE_SALE_OUT
  ONLINE_SALE_RESERVED // réservation le temps du paiement, pour éviter la double vente
  RETURN_IN
  ADJUSTMENT
  DEFECTIVE_OUT
}

// Table transactionnelle : toute variation de stock (caisse ou Marketplace) passe par ici.
// C'est le point d'unicité qui empêche la double vente décrite dans le cahier des charges.
model StockMovement {
  id        String            @id @default(uuid())
  shopId    String
  shop      Shop              @relation(fields: [shopId], references: [id])
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id])
  type      StockMovementType
  quantity  Int // signé : négatif pour une sortie
  reference String? // id de la vente / commande / achat liés
  createdAt DateTime          @default(now())
}

// ---------------------------------------------------------------------------
// ELEGANZ GESTION — caisse, vente physique, documents commerciaux
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  STORE_CREDIT
  CASH_ON_DELIVERY
}

model PosSale {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  cashierId   String
  cashier     User     @relation("CashierSales", fields: [cashierId], references: [id])
  customerId  String?
  customer    ShopCustomer? @relation(fields: [customerId], references: [id])
  totalAmount Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  status      String   @default("COMPLETED") // COMPLETED | CANCELLED | RETURNED
  // Clé d'idempotence pour la synchronisation hors-ligne (docs/ARCHITECTURE_HORS_LIGNE.md) :
  // générée côté client avant tout appel réseau, unique, pour qu'une
  // tentative renvoyée deux fois ne crée jamais deux ventes.
  clientOperationId String? @unique
  createdAt   DateTime @default(now())

  lines     PosSaleLine[]
  payments  PosPayment[]
  documents CommercialDocument[]
}

model PosSaleLine {
  id        String   @id @default(uuid())
  saleId    String
  sale      PosSale  @relation(fields: [saleId], references: [id])
  variantId String?  // vide si vente rapide d'un article non catalogué
  variant   Variant? @relation(fields: [variantId], references: [id])
  label     String   // désignation libre pour une vente non cataloguée
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  // true quand cette ligne a été acceptée en synchronisation différée alors
  // que le stock disponible était insuffisant (décision validée par le
  // propriétaire : on garde la vente — l'argent a réellement été encaissé —
  // et on laisse le stock descendre sous zéro plutôt que d'effacer une
  // transaction physique déjà survenue). La boutique régularise elle-même.
  stockDiscrepancy Boolean @default(false)
}

model PosPayment {
  id        String        @id @default(uuid())
  saleId    String
  sale      PosSale       @relation(fields: [saleId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  confirmed Boolean       @default(true) // false = déclaré manuellement, non confirmé par un prestataire
}

enum DocumentType {
  TICKET
  RECEIPT
  INVOICE_INTERNAL      // document commercial ordinaire, NON homologué
  INVOICE_FISCAL        // facture normalisée via MCF/e-DEF, une fois homologuée
  PROFORMA
  QUOTE
  CREDIT_NOTE
  DELIVERY_NOTE
}

model CommercialDocument {
  id        String       @id @default(uuid())
  shopId    String
  shop      Shop         @relation(fields: [shopId], references: [id])
  posSaleId String?
  posSale   PosSale?     @relation(fields: [posSaleId], references: [id])
  shopOrderId String?
  shopOrder ShopOrder?   @relation(fields: [shopOrderId], references: [id])
  type      DocumentType
  number    String       @unique
  isFiscallyHomologated Boolean @default(false) // ne jamais passer à true sans homologation DGI vérifiée
  pdfUrl    String?
  createdAt DateTime     @default(now())
}

model Supplier {
  id      String @id @default(uuid())
  shopId  String
  shop    Shop   @relation(fields: [shopId], references: [id])
  name    String
  phone   String?
  balanceOwed Decimal @default(0) @db.Decimal(12, 2) // dettes fournisseur

  purchases Purchase[]
}

model Purchase {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  // Conservé sur l'achat lui-même depuis le 13 oct. 2026 (moteur comptable,
  // docs/ARCHITECTURE_FINANCE.md §8bis.4) — jusqu'ici seul
  // Supplier.balanceOwed était mis à jour, sans garder trace par achat.
  // Défaut false pour l'historique déjà enregistré (hypothèse "payé", la
  // plus sûre pour ne pas inventer une dette fournisseur rétroactive).
  onCredit   Boolean  @default(false)
  receivedAt DateTime?
  createdAt  DateTime @default(now())
}

model Expense {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  category  String   // loyer, transport, salaires, électricité, télécom, livraison, autre
  amount    Decimal  @db.Decimal(12, 2)
  // Devise de la dépense (Finance & Comptabilité, 13 oct. 2026) — absente
  // jusqu'ici, contrairement à PosSale.currency ; défaut "USD" pour ne pas
  // réinterpréter silencieusement les dépenses déjà enregistrées.
  currency  String   @default("USD")
  note      String?
  createdAt DateTime @default(now())
}

model ShopCustomer {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  fullName    String
  phone       String?
  creditBalance Decimal @default(0) @db.Decimal(12, 2) // créances dues par ce client

  sales PosSale[]
}

// ---------------------------------------------------------------------------
// ELEGANZ MARKETPLACE — commandes en ligne multivendeurs
// ---------------------------------------------------------------------------

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED_DECLARED   // déclaré livré par le livreur
  RECEIVED_CONFIRMED   // confirmé reçu par le client — événement distinct
  CLOSED
  CANCELLED
  RETURN_REQUESTED
  REFUNDED
  DISPUTED
}

// Commande globale du client (peut couvrir plusieurs boutiques)
model Order {
  id        String      @id @default(uuid())
  buyerId   String
  buyer     User        @relation(fields: [buyerId], references: [id])
  totalAmount Decimal   @db.Decimal(12, 2)
  currency  String      @default("USD")
  createdAt DateTime    @default(now())

  // Coordonnées de livraison saisies au moment de la commande (prompt du
  // 12 oct. 2026) — la boutique en a besoin pour joindre le client et
  // organiser la livraison, au-delà du compte acheteur lui-même.
  // whatsappPhone en priorité (canal de contact préféré en RDC) ; phone en
  // repli si le client n'a pas WhatsApp.
  buyerWhatsapp    String?
  buyerPhone       String?
  deliveryCommune  String?
  deliveryQuartier String?
  deliveryAvenue   String?
  deliveryRepere   String?
  deliveryNote     String?

  shopOrders ShopOrder[]
  payments   OrderPayment[]
}

// Sous-commande par boutique — chaque vendeur ne voit que la sienne
model ShopOrder {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  shopId    String
  shop      Shop        @relation(fields: [shopId], references: [id])
  status    OrderStatus @default(CREATED)
  subtotal  Decimal     @db.Decimal(12, 2)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  // Réseau de livreurs plateforme (Driver) — fermé au grand public depuis le
  // 13 oct. 2026, conservé tel quel pour une réouverture future. Les
  // nouvelles affectations passent par shopDriverId ci-dessous.
  driverId  String?
  driver    Driver?     @relation(fields: [driverId], references: [id])
  // Livreur propre à la boutique (13 oct. 2026, 1ʳᵉ demande du jour) : pas
  // de compte ELEGANZ, pas de vérification plateforme — sous la seule
  // responsabilité de la boutique qui l'a enregistré. Une sous-commande n'a
  // jamais les deux à la fois en pratique (voir DeliveryService.assignDriver
  // / assignShopDriver), mais les deux champs restent indépendants dans le
  // schéma pour ne pas invalider l'historique si le réseau plateforme rouvre.
  shopDriverId String?
  shopDriver   ShopDriver? @relation(fields: [shopDriverId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lines         OrderLine[]
  documents     CommercialDocument[]
  dispute       Dispute?
  reviews       Review[]
  statusEvents  OrderStatusEvent[]
}

// Horodatage de chaque changement de statut d'une sous-commande (demande du
// 12 oct. 2026, point 4 — suivi des SLA et du comportement des acteurs).
// ShopOrder.status ne garde que le statut courant ; sans cette table il est
// impossible de savoir, par exemple, combien de temps une boutique met en
// moyenne pour accepter une commande. N'existe qu'à partir du déploiement de
// cette fonctionnalité — les commandes déjà closes avant cette date n'ont
// pas d'historique rétroactif, seulement leur statut final.
model OrderStatusEvent {
  id          String      @id @default(uuid())
  shopOrderId String
  shopOrder   ShopOrder   @relation(fields: [shopOrderId], references: [id])
  status      OrderStatus
  occurredAt  DateTime    @default(now())

  @@index([shopOrderId])
}

model OrderLine {
  id        String  @id @default(uuid())
  shopOrderId String
  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
}

model OrderPayment {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  method    PaymentMethod
  provider  String?       // "moneroo", "orange_direct", "cash_on_delivery", ...
  amount    Decimal       @db.Decimal(12, 2)
  confirmed Boolean       @default(false)
  providerRef String?
  createdAt DateTime      @default(now())
}

model Dispute {
  id          String    @id @default(uuid())
  shopOrderId String    @unique
  shopOrder   ShopOrder @relation(fields: [shopOrderId], references: [id])
  reason      String
  status      String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED
  resolution  String?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// AVIS, COMMENTAIRES & TÉMOIGNAGES — crédibilité de la plateforme (prompt du
// 12 oct. 2026). Un avis cible toujours une boutique, et optionnellement un
// article précis. `shopOrderId`, quand renseigné, rattache l'avis à une
// commande réelle de l'auteur — `verifiedPurchase` est calculé une seule
// fois à la création à partir du statut de cette commande (voir le champ
// plus bas), jamais déduit de la seule déclaration du client.
model Review {
  id          String    @id @default(uuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  shopOrderId String?
  shopOrder   ShopOrder? @relation(fields: [shopOrderId], references: [id])
  rating      Int // 1 à 5
  comment     String?
  // Calculé une seule fois à la création, à partir du statut de la commande
  // liée (RECEIVED_CONFIRMED ou CLOSED) — pas recalculé ensuite : un retour
  // tardif sur une commande déjà close ne doit pas faire disparaître
  // rétroactivement un avis déjà publié et lu.
  verifiedPurchase Boolean @default(false)
  isPublished Boolean   @default(true) // modération a posteriori (admin), jamais pré-modéré
  createdAt   DateTime  @default(now())

  @@unique([authorId, shopOrderId])
}

// ---------------------------------------------------------------------------
// LIVRAISON
// ---------------------------------------------------------------------------

enum DriverVehicleType {
  PIED
  VELO
  MOTO
  VOITURE
}

model Driver {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  zone      String?
  verified  Boolean  @default(false)

  // Informations à fournir à l'inscription pour que l'administration puisse
  // instruire le dossier avant de valider la souscription (prompt du
  // 13 oct. 2026, point 2) — toutes facultatives au niveau du schéma (pour
  // ne pas invalider les livreurs déjà inscrits avant ce champ) ; la DTO
  // d'inscription (RegisterDriverDto) les exige selon le type de véhicule
  // déclaré : plaque + permis obligatoires en moto/voiture, pas à pied/vélo.
  phone            String?
  whatsapp         String?
  address          String?
  vehicleType      DriverVehicleType?
  vehiclePlate     String?
  licenseNumber    String?
  idDocumentNumber String?
  // Note interne de l'administration pendant l'instruction du dossier (ex.
  // "pièce d'identité illisible, à refaire") — jamais visible du livreur.
  adminNote        String?

  // Facturation de l'espace livreur (prompt du 13 oct. 2026, point 1) —
  // indépendante de `verified` (identité/dossier) : un livreur peut être
  // vérifié mais suspendu pour impayé, ou inversement en attente de
  // vérification alors que sa période gratuite tourne déjà. `freeTrialStartedAt`
  // n'est renseigné qu'au moment où l'admin valide le dossier (verified=true
  // pour la première fois), jamais à l'inscription elle-même.
  billingStatus      DriverBillingStatus @default(FREE_PERIOD)
  freeTrialStartedAt DateTime?

  deliveries ShopOrder[]
  invoices   DriverInvoice[]
}

enum DriverBillingStatus {
  FREE_PERIOD  // période de gratuité en cours, pas encore facturé
  PAYMENT_DUE  // gratuité écoulée, facture(s) en attente de règlement
  ACTIVE       // à jour de ses paiements
  SUSPENDED    // impayé au-delà du délai de grâce — missions bloquées
}

// Livreur propre à une boutique (13 oct. 2026, 1ʳᵉ demande du jour — en
// remplacement du réseau de livreurs plateforme, fermé au grand public pour
// limiter le risque de malhonnêteté au lancement). Pas de compte ELEGANZ :
// une simple fiche gérée par la boutique elle-même, sous sa propre
// responsabilité en cas de perte ou de vol — jamais celle de la plateforme.
// Le personnel de boutique marque lui-même les étapes de livraison (via
// PATCH /shops/:shopId/orders/:shopOrderId/status, déjà existant), puisque
// ce livreur n'a pas de compte pour confirmer ses propres étapes.
model ShopDriver {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  fullName    String
  phone       String?
  vehicleType String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  deliveries ShopOrder[]

  @@index([shopId])
}

model DeliveryZone {
  id       String  @id @default(uuid())
  commune  String
  fee      Decimal @db.Decimal(12, 2)
  active   Boolean @default(true)
}

// ---------------------------------------------------------------------------
// MONÉTISATION — bouquets, abonnements, crédits IA (100 % administrables)
// ---------------------------------------------------------------------------

enum PlanCategory {
  MARKETPLACE
  GESTION
}

model SubscriptionPlan {
  id             String       @id @default(uuid())
  category       PlanCategory
  name           String
  monthlyPrice   Decimal      @db.Decimal(12, 2)
  maxActiveProducts Int?
  featuresJson   Json         // liste des fonctionnalités incluses, éditable en admin
  active         Boolean      @default(true)

  marketplaceShops Shop[] @relation("MarketplaceBouquet")
  gestionShops     Shop[] @relation("GestionBouquet")
  subscriptions    ShopSubscription[]
}

model ShopSubscription {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  startedAt DateTime @default(now())
  renewsAt  DateTime?
  status    String   @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELLED
}

model Invoice {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  dueAt     DateTime
  paidAt    DateTime?
  status    String   @default("PENDING") // PENDING | PAID | OVERDUE | WAIVED
  kind      String   // "opening_fee" | "subscription" | "ai_credits" | ...
  createdAt DateTime @default(now())
}

model DriverInvoice {
  id        String   @id @default(uuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  dueAt     DateTime
  paidAt    DateTime?
  status    String   @default("PENDING") // PENDING | PAID | OVERDUE | WAIVED
  kind      String   // "opening_fee" | "subscription"
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// ELEGANZ MON COMPTABLE — carnet de gestion quotidienne (prompt du
// 13 oct. 2026, mission complémentaire). Module fonctionnellement autonome
// (aucune boutique ni catalogue requis) mais rattaché au compte ELEGANZ
// commun : chaque modèle ci-dessous part de `User`, jamais de `Shop`. Les
// montants restent toujours dans leur devise d'origine (CDF ou USD) — on ne
// fusionne jamais deux devises dans un même total sans conversion explicite
// (prompt §5), d'où `ComptableCurrency` répété sur chaque ligne plutôt
// qu'un total unique par activité.
// ---------------------------------------------------------------------------

enum ComptableCurrency {
  CDF
  USD
}

enum ComptableActivityCategory {
  COMMERCE
  LOCATION
  VEHICULE
  SERVICE
  AUTRE
}

model ComptableActivity {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  name       String
  category   ComptableActivityCategory
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  entries           ComptableEntry[]
  debts             ComptableDebt[]
  rentalUnits       ComptableRentalUnit[]
  workerRemittances ComptableWorkerRemittance[]
}

// Sens du flux — une vente et un emprunt reçu sont tous deux des ENTREE,
// mais ne doivent jamais être confondus dans l'analyse (prompt §6) : c'est
// `category`, pas `direction`, qui porte cette distinction.
enum ComptableFlowDirection {
  ENTREE
  SORTIE
}

enum ComptableFlowCategory {
  // Entrées
  VENTE
  PRESTATION
  LOYER_RECU
  REMBOURSEMENT_CREANCE
  APPORT_PERSONNEL
  EMPRUNT_RECU
  AUTRE_ENTREE
  // Sorties
  ACHAT
  TRANSPORT
  LOYER_PAYE
  ENTRETIEN
  REPARATION
  DEPENSE_FONCTIONNEMENT
  REMBOURSEMENT_DETTE
  AUTRE_SORTIE
}

// Une ligne de carnet (vente, dépense, loyer reçu...). La saisie simplifiée
// à une ligne par jour (prompt §5) crée jusqu'à 4 lignes ici (vente CDF,
// vente USD, dépense CDF, dépense USD) plutôt qu'un format dénormalisé —
// garde les statistiques par devise/catégorie fiables sans réécrire de
// logique d'agrégation séparée pour la saisie rapide.
model ComptableEntry {
  id          String   @id @default(uuid())
  activityId  String
  activity    ComptableActivity @relation(fields: [activityId], references: [id])
  date        DateTime // date réelle de l'opération (saisie rétroactive permise, prompt §5)
  direction   ComptableFlowDirection
  category    ComptableFlowCategory
  currency    ComptableCurrency
  amount      Decimal  @db.Decimal(14, 2)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Marqueur d'idempotence pour la saisie différée hors-ligne de Mon Comptable
// (prompt du 13 oct. 2026, point 2 : "saisie différée synchronisée au retour
// du réseau") — même principe que PosSale.clientOperationId, mais sous forme
// de ligne séparée plutôt qu'un champ sur ComptableEntry, car une seule
// soumission de saisie rapide peut créer plusieurs ComptableEntry à la fois
// (ventes et dépenses CDF/USD en une fois) : on ne peut pas mettre la
// contrainte @unique sur plusieurs lignes nées de la même opération. Rejouer
// la synchronisation avec le même clientOperationId est donc un no-op sûr
// plutôt qu'un doublon.
model ComptableSyncMarker {
  id                String   @id @default(uuid())
  clientOperationId String   @unique
  userId            String
  createdAt         DateTime @default(now())
}

enum ComptableDebtType {
  DETTE   // ce que je dois payer
  CREANCE // ce que d'autres me doivent
  EMPRUNT // somme empruntée, avec ses propres modalités
}

model ComptableDebt {
  id               String   @id @default(uuid())
  activityId       String
  activity         ComptableActivity @relation(fields: [activityId], references: [id])
  type             ComptableDebtType
  counterpartyName String
  description      String?
  amount           Decimal  @db.Decimal(14, 2)
  currency         ComptableCurrency
  startDate        DateTime @default(now())
  dueDate          DateTime?
  settled          Boolean  @default(false)
  createdAt        DateTime @default(now())

  payments ComptableDebtPayment[]
}

model ComptableDebtPayment {
  id      String   @id @default(uuid())
  debtId  String
  debt    ComptableDebt @relation(fields: [debtId], references: [id])
  amount  Decimal  @db.Decimal(14, 2)
  paidAt  DateTime @default(now())
  note    String?
}

enum ComptableRentFrequency {
  MENSUEL
  TRIMESTRIEL
  ANNUEL
  PERSONNALISE
}

model ComptableRentalUnit {
  id            String   @id @default(uuid())
  activityId    String
  activity      ComptableActivity @relation(fields: [activityId], references: [id])
  label         String // désignation (ex. "Appartement 2, Lemba")
  location      String?
  tenantName    String?
  rentAmount    Decimal  @db.Decimal(14, 2)
  currency      ComptableCurrency
  frequency     ComptableRentFrequency @default(MENSUEL)
  leaseStart    DateTime?
  leaseEnd      DateTime?
  // Garantie locative — distincte des loyers encaissés (prompt §8), jamais
  // comptée dans les montants reçus/attendus d'une période.
  depositAmount Decimal? @db.Decimal(14, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  payments ComptableRentPayment[]
  expenses ComptableRentExpense[]
}

model ComptableRentPayment {
  id             String   @id @default(uuid())
  unitId         String
  unit           ComptableRentalUnit @relation(fields: [unitId], references: [id])
  periodLabel    String // ex. "Octobre 2026"
  expectedAmount Decimal  @db.Decimal(14, 2)
  receivedAmount Decimal  @default(0) @db.Decimal(14, 2)
  dueDate        DateTime
  paidAt         DateTime?
  note           String?
  createdAt      DateTime @default(now())
}

model ComptableRentExpense {
  id         String   @id @default(uuid())
  unitId     String
  unit       ComptableRentalUnit @relation(fields: [unitId], references: [id])
  category   String // entretien | réparation | travaux | gardiennage | eau | électricité | autre
  amount     Decimal  @db.Decimal(14, 2)
  currency   ComptableCurrency
  date       DateTime @default(now())
  note       String?
}

// Suivi des versements d'un travailleur confié à une activité (prompt §9) —
// `paidAmount` est ce que le travailleur a réellement remis au propriétaire ;
// `declaredRevenue`/`declaredExpenses` restent déclaratifs, jamais vérifiés
// automatiquement. Un transfert entre la caisse du travailleur et celle du
// propriétaire reste ici, hors de ComptableEntry, pour ne jamais être compté
// deux fois comme un revenu (prompt §9).
model ComptableWorkerRemittance {
  id               String   @id @default(uuid())
  activityId       String
  activity         ComptableActivity @relation(fields: [activityId], references: [id])
  workerName       String
  periodLabel      String
  expectedAmount   Decimal? @db.Decimal(14, 2)
  declaredRevenue  Decimal? @db.Decimal(14, 2)
  declaredExpenses Decimal? @db.Decimal(14, 2)
  paidAmount       Decimal  @default(0) @db.Decimal(14, 2)
  currency         ComptableCurrency
  dueDate          DateTime?
  settledAt        DateTime?
  note             String?
  createdAt        DateTime @default(now())
}

enum ComptableBillingStatus {
  FREE_PERIOD
  PAYMENT_DUE
  ACTIVE
  SUSPENDED
}

// Un seul abonnement Mon Comptable par compte ELEGANZ (prompt §3 : compte
// commun), partagé par toutes les activités de l'utilisateur — jamais un
// abonnement par activité. `freeTrialStartedAt` n'est posé qu'à la première
// activation effective (prompt §14), pas à la création du compte ELEGANZ.
model ComptableSubscription {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  billingStatus      ComptableBillingStatus @default(FREE_PERIOD)
  activatedAt        DateTime @default(now())
  freeTrialStartedAt DateTime @default(now())
  plan               String? // "MONTHLY" | "YEARLY" — choisi à la première échéance
  renewsAt           DateTime?
  createdAt          DateTime @default(now())

  invoices ComptableInvoice[]
}

model ComptableInvoice {
  id             String   @id @default(uuid())
  subscriptionId String
  subscription   ComptableSubscription @relation(fields: [subscriptionId], references: [id])
  amount         Decimal  @db.Decimal(12, 2)
  dueAt          DateTime
  paidAt         DateTime?
  status         String   @default("PENDING") // PENDING | PAID | OVERDUE | WAIVED
  kind           String   // "monthly" | "yearly"
  createdAt      DateTime @default(now())
}

model AiCreditWallet {
  id        String  @id @default(uuid())
  shopId    String  @unique
  shop      Shop    @relation(fields: [shopId], references: [id])
  balance   Int     @default(0)

  transactions AiCreditTransaction[]
}

model AiCreditTransaction {
  id        String   @id @default(uuid())
  walletId  String
  wallet    AiCreditWallet @relation(fields: [walletId], references: [id])
  delta     Int // négatif = consommation, positif = achat/remboursement
  service   String // "image_optimization" | "ad_generation" | "video_generation" | ...
  createdAt DateTime @default(now())
}

model AiService {
  id          String  @id @default(uuid())
  name        String
  description String?
  creditCost  Int
  active      Boolean @default(true)
  provider    String? // fournisseur technique
}

// ---------------------------------------------------------------------------
// AUDIT — traçabilité obligatoire des actions sensibles (prompt §41)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  shopId    String?
  shop      Shop?    @relation(fields: [shopId], references: [id])
  action    String
  details   Json?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// FINANCE & COMPTABILITÉ (prompt du 13 oct. 2026) — voir docs/ARCHITECTURE_FINANCE.md
// ---------------------------------------------------------------------------

// Une seule table pour les deux niveaux "boutique" et "ELEGANZ elle-même"
// (§15 du prompt exige 3 niveaux : référentiel central, boutique, ELEGANZ ;
// le référentiel central n'est pas encore modélisé séparément à cette phase,
// voir docs/ARCHITECTURE_FINANCE.md §7). La séparation stricte exigée par le
// prompt ("dans le modèle de données et les contrôles d'accès, pas
// seulement dans l'affichage") est appliquée au niveau service/contrôleur :
// les routes boutique ne touchent jamais scope=PLATFORM, les routes admin
// ne touchent jamais scope=SHOP — jamais une simple confiance dans l'UI.
enum FiscalRuleScope {
  SHOP
  PLATFORM
}

enum FiscalRuleCategory {
  TVA
  IMPOT
  RETENUE
  CONTRIBUTION
  AUTRE
}

// Statuts du §5.5 du prompt. VERIFIEE existe dans le modèle mais n'a pas
// encore de flux d'invitation de professionnel réel à cette phase (voir
// docs/ARCHITECTURE_FINANCE.md §7) — n'atteindre ce statut que par bascule
// manuelle documentée comme limite, jamais présenté comme une vérification
// professionnelle réellement effectuée par le système.
enum FiscalRuleStatus {
  PROPOSEE
  CONFIGUREE
  VERIFIEE
  OBSOLETE
}

model FiscalRule {
  id               String             @id @default(uuid())
  scope            FiscalRuleScope
  shopId           String?
  shop             Shop?              @relation(fields: [shopId], references: [id])
  label            String
  category         FiscalRuleCategory
  rateOrFormula    String
  baseCalcul       String?
  champApplication String?
  regime           String?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  sourceReference  String?
  status           FiscalRuleStatus   @default(PROPOSEE)
  lastModifiedBy   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  versions FiscalRuleVersion[]

  @@index([shopId])
  @@index([scope])
}

// Historique de versions (§5.7 du prompt) — jamais d'effacement silencieux :
// chaque modification ajoute une ligne, ne réécrit jamais l'ancienne.
model FiscalRuleVersion {
  id            String           @id @default(uuid())
  ruleId        String
  rule          FiscalRule       @relation(fields: [ruleId], references: [id])
  oldValue      Json?
  newValue      Json
  authorId      String?
  motif         String?
  effectiveDate DateTime
  status        FiscalRuleStatus
  createdAt     DateTime         @default(now())

  @@index([ruleId])
}

// ---------------------------------------------------------------------------
// MOTEUR DE COMPTABILITÉ EN PARTIE DOUBLE (13 oct. 2026, Phase 2 — voir
// docs/ARCHITECTURE_FINANCE.md §8bis). Reprend le patron déjà validé pour
// FiscalRule : un seul jeu de modèles, séparé par scope (SHOP/PLATFORM) +
// shopId nullable, isolation imposée côté service/contrôleur, jamais
// seulement par l'affichage. Volontairement minimal : assez pour un journal
// général, un grand livre et une balance réels — pas de clôture, pas d'états
// financiers réglementaires (toujours listés comme différés).
// ---------------------------------------------------------------------------

enum AccountNormalSide {
  DEBIT
  CREDIT
}

model Account {
  id            String            @id @default(uuid())
  scope         FiscalRuleScope
  shopId        String?
  shop          Shop?             @relation(fields: [shopId], references: [id])
  code          String // ex. "571", "701", "601" (SYSCOHADA révisé)
  label         String
  normalSide    AccountNormalSide
  // true pour les comptes seedés automatiquement par AccountingSeedService,
  // false pour un compte créé manuellement plus tard (non exposé à cette
  // phase, mais le champ existe pour ne pas distinguer les deux origines
  // après coup si un écran de création manuelle est ajouté).
  systemDefined Boolean           @default(true)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())

  lines JournalLine[]

  @@unique([scope, shopId, code])
  @@index([scope, shopId])
}

enum JournalEntrySource {
  POS_SALE
  SHOP_ORDER
  EXPENSE
  PURCHASE
  INVOICE
  MANUAL
  DEPRECIATION
}

model Journal {
  id     String          @id @default(uuid())
  scope  FiscalRuleScope
  shopId String?
  shop   Shop?           @relation(fields: [shopId], references: [id])
  code   String // VE (ventes), AC (achats), TR (trésorerie), OD (opérations diverses)
  label  String

  entries JournalEntry[]

  @@unique([scope, shopId, code])
}

model JournalEntry {
  id         String             @id @default(uuid())
  scope      FiscalRuleScope
  shopId     String?
  shop       Shop?              @relation(fields: [shopId], references: [id])
  journalId  String
  journal    Journal            @relation(fields: [journalId], references: [id])
  entryDate  DateTime
  label      String
  sourceType JournalEntrySource
  // id de PosSale/ShopOrder/Expense/Purchase/Invoice à l'origine de
  // l'écriture ; null pour une écriture MANUAL. Sert de garde-fou anti
  // double-comptabilisation via l'unicité ci-dessous (NULL n'entre jamais en
  // conflit avec un index unique Postgres, donc les écritures MANUAL ne se
  // bloquent jamais entre elles).
  sourceId   String?
  createdAt  DateTime           @default(now())

  lines JournalLine[]

  @@unique([scope, shopId, sourceType, sourceId])
  @@index([scope, shopId, entryDate])
}

model JournalLine {
  id        String       @id @default(uuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id])
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Decimal      @default(0) @db.Decimal(12, 2)
  credit    Decimal      @default(0) @db.Decimal(12, 2)
  label     String?

  @@index([entryId])
  @@index([accountId])
}

// Immobilisations et amortissements (13 oct. 2026, Finance & Comptabilité
// Phase 4) — voir docs/ARCHITECTURE_FINANCE.md §8quater. Amortissement
// linéaire uniquement à cette phase (le seul mode réellement demandé).
// Comptabilisé via AccountingService (compte 681 débité / 2841 crédité),
// jamais calculé ici directement.
model Asset {
  id               String    @id @default(uuid())
  scope            FiscalRuleScope
  shopId           String?
  shop             Shop?     @relation(fields: [shopId], references: [id])
  label            String
  acquisitionDate  DateTime
  acquisitionCost  Decimal   @db.Decimal(12, 2)
  currency         String    @default("USD")
  // Durée d'amortissement en mois (ex. 60 pour 5 ans) — pas de table de
  // durées réglementaires par catégorie à cette phase, saisie libre par
  // l'utilisateur.
  durationMonths   Int
  disposed         Boolean   @default(false)
  disposedAt       DateTime?
  createdAt        DateTime  @default(now())

  depreciations AssetDepreciation[]

  @@index([scope, shopId])
}

// Une ligne par mois réellement comptabilisé pour un actif donné — la clé
// `[assetId, periodDate]` est composite mais SANS champ nullable (contrairement
// à l'incident déjà documenté dans MAINTENANCE.md), donc utilisable sans
// risque dans `findUnique`/`upsert` si besoin plus tard.
model AssetDepreciation {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])
  periodDate DateTime
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@unique([assetId, periodDate])
}
