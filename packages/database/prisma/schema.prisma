// ELEGANZ — schéma de données unifié (ELEGANZ Gestion + ELEGANZ Marketplace)
// Choix d'architecture : PostgreSQL, accédé via Prisma depuis l'API NestJS.
// Voir /docs/DATABASE.md pour la justification de chaque bloc.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// PARAMÈTRES PLATEFORME — coordonnées officielles ELEGANZ (prompt du
// 12 oct. 2026), modifiables depuis le Centre de pilotage sans toucher au
// code. Table singleton : une seule ligne, id fixe "platform".
// ---------------------------------------------------------------------------

model PlatformSettings {
  id            String  @id @default("platform")
  address       String?
  website       String?
  supportEmail  String?
  supportPhone  String? // numéro de contact (peut aussi servir pour WhatsApp si identique)
  whatsappLink  String?
  telegramLink  String?
  tiktokUrl     String?
  instagramUrl  String?

  // Fonctionnalités IA "prévues mais inactives" (demande du 12 oct. 2026) :
  // le code et les points d'entrée existent déjà dans l'écran (bouton
  // visible mais désactivé, "Bientôt disponible"), mais restent coupés tant
  // qu'aucun fournisseur n'est choisi ET payé — ni Claude, qui ne fait ni
  // comparaison d'image ni génération d'image/vidéo, ni un budget engagé.
  // L'admin pourra les activer lui-même ici une fois le fournisseur branché,
  // sans redéploiement, en fonction des recettes/de la croissance.
  photoSearchEnabled Boolean @default(false)
  adStudioEnabled    Boolean @default(false)

  // Chatbox native (demande UX du 15 oct. 2026, point 3) : bulle flottante
  // visible dans les espaces authentifiés, qui ouvre le centre de
  // messagerie. Interrupteur global pour pouvoir la désactiver depuis le
  // Centre de pilotage sans redéploiement.
  chatWidgetEnabled Boolean @default(true)

  // Tarification de l'espace livreur (prompt du 13 oct. 2026, point 1) —
  // frais d'ouverture à la souscription + abonnement mensuel, tous deux
  // paramétrables depuis le Centre de pilotage, avec un nombre de mois de
  // gratuité décompté à partir de la validation (vérification admin) de
  // l'inscription du livreur. Valeurs de départ demandées : 10 $ à la
  // souscription, 5 $/mois, 8 mois gratuits.
  driverOpeningFee   Decimal  @default(10) @db.Decimal(12, 2)
  driverMonthlyFee   Decimal  @default(5)  @db.Decimal(12, 2)
  driverFreeMonths   Int      @default(8)

  // Tarification d'ELEGANZ Secourable (prompt du 13 oct. 2026, §14) —
  // 6 mois gratuits à compter de la première activation effective, puis
  // 1 $/mois ou 10 $/an, entièrement paramétrable depuis le Centre de
  // pilotage sans redéploiement.
  comptableMonthlyFee Decimal @default(1)  @db.Decimal(12, 2)
  comptableYearlyFee  Decimal @default(10) @db.Decimal(12, 2)
  comptableFreeMonths Int     @default(6)

  // Taux de change système CDF/USD (prompt du 13 oct. 2026, point 5) — un
  // seul taux pour toute la plateforme, géré uniquement depuis le Centre de
  // pilotage. Nullable tant qu'aucun admin ne l'a configuré : tant qu'il est
  // vide, aucun équivalent de devise ne s'affiche nulle part plutôt que
  // d'inventer une valeur de départ. Phase 1 (affichage courant uniquement,
  // voir docs/PROJECT_STATUS.md) : converti "au taux du jour", jamais figé
  // rétroactivement sur une vente/opération déjà enregistrée — c'est
  // exchangeRateUpdatedAt + ExchangeRateHistory qui permettent de savoir
  // quel taux était affiché à quel moment, pas une conversion a posteriori
  // des montants déjà enregistrés.
  cdfPerUsd             Decimal?  @db.Decimal(14, 4)
  exchangeRateUpdatedAt DateTime?

  // Taux de commission (%) par défaut sur les transactions ELEGANZ Market,
  // utilisé quand le bouquet Marketplace de la boutique n'en définit pas un
  // lui-même (14 oct. 2026, plan commercial). Nullable : tant qu'il est
  // vide et qu'aucun bouquet ne le fixe non plus, la commission reste à 0 —
  // jamais une valeur de départ inventée.
  marketplaceCommissionRateDefault Decimal? @db.Decimal(5, 2)

  // Services à la carte (14 oct. 2026, plan commercial) — tarification
  // configurable depuis le Centre de pilotage, sans redéploiement.
  // Crédits IA : prix USD d'un crédit, utilisé pour calculer le montant de
  // la facture à l'achat (voir AiCreditTopUp) ; nul tant que l'admin n'a
  // rien fixé, la demande d'achat reste alors indisponible. Le coût en
  // crédits de chaque service IA reste fixé service par service
  // (`AiService.creditCost`), jamais ici.
  aiCreditUnitPrice Decimal? @db.Decimal(10, 4)

  // SMS/WhatsApp premium : pour l'instant un simple interrupteur + tarif
  // affichés dans le Centre de pilotage, PAS une fonctionnalité branchée —
  // aucun compte Twilio/WhatsApp Business n'existe (voir docs/PROJECT_STATUS.md,
  // "Pas encore commencé"). Permet à l'admin de préparer/afficher le prix dès
  // maintenant sans attendre l'intégration technique.
  smsWhatsappPremiumEnabled    Boolean  @default(false)
  smsWhatsappPremiumMonthlyFee Decimal? @db.Decimal(10, 2)

  // Canaux de notification (15 oct. 2026, demande UX point 7) — activables
  // depuis le Centre de pilotage "au moment voulu" : l'in-app est le seul
  // canal réellement câblé à ce jour (NotificationsService n'écrit jamais
  // de ligne Notification pour un canal désactivé ici) ; email/SMS existent
  // déjà comme interrupteurs pour que l'admin prépare l'activation future,
  // mais n'ont aucun fournisseur d'envoi branché tant que ces canaux
  // réclament un investissement non encore engagé (même logique que
  // smsWhatsappPremiumEnabled ci-dessus).
  notificationsInAppEnabled Boolean @default(true)
  notificationsEmailEnabled Boolean @default(false)
  notificationsSmsEnabled   Boolean @default(false)

  // Identité fiscale d'ELEGANZ en tant que société (16 oct. 2026, point 2) —
  // même esprit que Shop.fiscalLegalName/fiscalIdNumber/fiscalAddress/
  // fiscalRegime, pour le dossier crédit et le rapport annuel de la
  // plateforme elle-même. Tous facultatifs : tant que l'admin ne les
  // renseigne pas, rien n'est déduit ni affiché à leur place.
  platformFiscalLegalName String?
  platformFiscalIdNumber  String?
  platformFiscalAddress   String?
  platformFiscalRegime    String?
  platformFoundedAt       DateTime?

  updatedAt     DateTime @updatedAt
}

// Historique des changements du taux de change système (prompt du 13 oct.
// 2026, point 5) — append-only, jamais modifié ni supprimé. Sert à répondre
// à "quel taux était affiché à telle date", notamment utile le jour où une
// phase 2 voudra figer le taux sur chaque transaction au lieu de toujours
// utiliser le taux courant (voir note sur PlatformSettings.cdfPerUsd).
model ExchangeRateHistory {
  id          String   @id @default(uuid())
  cdfPerUsd   Decimal  @db.Decimal(14, 4)
  setAt       DateTime @default(now())
  setByUserId String?

  @@index([setAt])
}

// ---------------------------------------------------------------------------
// IDENTITÉ & ACCÈS
// ---------------------------------------------------------------------------

enum UserRole {
  BUYER
  SHOP_OWNER
  SHOP_STAFF // gérant, caissier, magasinier, comptable — précisé par StaffRole
  DRIVER
  ADMIN_SUPER
  ADMIN_SALES
  ADMIN_FINANCE
  ADMIN_OPS
  ADMIN_LOGISTICS
  ADMIN_MARKETING
  ADMIN_SUPPORT
  ADMIN_AUDITOR
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  STOCK_KEEPER
  SALES_LEAD
  ACCOUNTANT
  // Comptable externe invité par la boutique (13 oct. 2026, Finance &
  // Comptabilité Phase 6) — contrairement à ACCOUNTANT (staff interne, accès
  // large comme tout membre actif sauf exceptions ponctuelles), ce rôle est
  // volontairement restreint en LECTURE SEULE aux routes Finance &
  // Comptabilité (finance/assets/expenses) par ShopMembershipGuard — voir
  // docs/ARCHITECTURE_FINANCE.md §8sexies. Jamais d'accès à la Caisse, au
  // Catalogue, aux Commandes, à l'Équipe ou aux Paramètres.
  EXTERNAL_ACCOUNTANT
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  phone         String?  @unique
  passwordHash  String?
  role          UserRole
  fullName      String
  locale        String   @default("fr")
  // Support admin (prompt du 12 oct. 2026, "Centre de pilotage" — gestion
  // des comptes utilisateurs) : un admin peut bloquer la connexion d'un
  // compte posant problème, sans jamais supprimer ses données.
  isSuspended   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shopMemberships ShopStaff[]
  ownedShops      Shop[]        @relation("ShopOwner")
  orders          Order[]
  posSales        PosSale[]     @relation("CashierSales")
  driverProfile   Driver?
  addresses       Address[]
  auditLogs       AuditLog[]
  reviews         Review[]
  comptableSubscription  ComptableSubscription?
  comptableActivities    ComptableActivity[]

  // Notifications & messagerie (15 oct. 2026, fondations UX points 4 et 7)
  notifications               Notification[]
  conversationParticipations  ConversationParticipant[]
  sentMessages                Message[]

  // Module Experts (16 oct. 2026, point 2) — tout utilisateur ELEGANZ peut
  // postuler comme expert (candidature → modération admin), d'où une relation
  // optionnelle 1-1 plutôt qu'un nouveau rôle dans UserRole.
  expertProfile          ExpertProfile?
  expertInvitesCreated   ShopExpertInvite[]      @relation("ExpertInviteCreatedBy")
  expertEngagementsGiven ShopExpertEngagement[]  @relation("ExpertEngagementInvitedBy")
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  commune     String?
  quartier    String?
  avenue      String?
  repere      String? // point de repère, utile à Kinshasa
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
}

// ---------------------------------------------------------------------------
// BOUTIQUES — cœur du modèle "3 modes" (privée / marketplace / hybride)
// ---------------------------------------------------------------------------

enum ShopMode {
  PRIVATE    // ELEGANZ Gestion uniquement, rien de publié
  MARKETPLACE // vente en ligne uniquement
  HYBRID     // gestion physique + vente en ligne, stock unifié
}

enum ShopStatus {
  PENDING_VALIDATION
  FREE_PERIOD
  ACTIVE
  PAYMENT_DUE
  SUSPENDED
  CLOSED
}

// ---------------------------------------------------------------------------
// GÉOGRAPHIE — pays/villes de référence pour les zones de livraison des
// boutiques Marketplace (demande du 15 oct. 2026 : "faciliter les acheteurs
// et les vendeurs" en rattachant à chaque vendeur les lieux où il peut
// livrer). Liste volontairement amorcée avec la RDC et ses pays limitrophes
// seulement ; `continent` existe dès maintenant pour anticiper l'ouverture
// progressive aux autres pays, dans l'ordre convenu : Afrique, puis Asie,
// Amérique, Europe, Océanie — ajouter un pays plus tard ne demandera que de
// nouvelles lignes de seed (GeoService), jamais de nouvelle migration.
enum Continent {
  AFRIQUE
  ASIE
  AMERIQUE
  EUROPE
  OCEANIE
}

model Country {
  id        String   @id @default(uuid())
  isoCode   String   @unique // ISO 3166-1 alpha-2, ex. "CD"
  // Nom canonique (français) — valeur de repli tant qu'aucune traduction
  // n'existe pour la langue active (voir translations.ts, clé pays_<isoCode>).
  name      String
  continent Continent

  cities        City[]
  deliveryZones ShopDeliveryZone[]
}

model City {
  id        String  @id @default(uuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  name      String

  deliveryZones ShopDeliveryZone[]

  @@unique([countryId, name])
}

// Zone de livraison déclarée par un vendeur (prompt du 15 oct. 2026) — une
// boutique peut en avoir plusieurs ; chaque zone est un couple pays+ville
// précis, jamais une saisie libre, pour rester filtrable côté acheteur.
model ShopDeliveryZone {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())

  @@unique([shopId, cityId])
}

model Shop {
  id               String     @id @default(uuid())
  ownerId          String
  owner            User       @relation("ShopOwner", fields: [ownerId], references: [id])
  name             String
  slug             String     @unique
  mode             ShopMode   @default(PRIVATE)
  status           ShopStatus @default(PENDING_VALIDATION)

  // Marketplace : visibilité publique
  isPubliclyListed Boolean    @default(false)

  // Identité affichée sur les documents imprimés (factures, bons de
  // livraison, tickets...) — personnalisable par chaque boutique (prompt
  // du 12 oct. 2026). Tous facultatifs : une boutique qui ne les renseigne
  // pas voit simplement son document sans cette ligne, jamais une valeur
  // inventée à sa place.
  invoiceAddress    String?
  invoicePhone      String?
  invoiceLogoUrl    String?
  invoiceFooterNote String? // ex. "Merci pour votre achat !", conditions de retour, etc.

  // Décision #9 (docs/COMPLIANCE_FACTURE_NORMALISEE.md) : les deux formats
  // de facture (homologuée DGI et non homologuée) doivent être proposables
  // au choix dès le départ, mais une boutique ne peut émettre une facture
  // fiscale homologuée qu'une fois ce champ activé manuellement par un
  // administrateur ELEGANZ, après vérification réelle de son homologation.
  fiscalHomologationConfirmed Boolean @default(false)

  // Identité fiscale de l'entreprise (Finance & Comptabilité, 13 oct. 2026,
  // §5.1) — tous facultatifs et vides par défaut : rien n'est présumé pour
  // une boutique qui ne les a pas renseignés, et aucune valeur n'est
  // déduite automatiquement d'un autre champ.
  fiscalLegalName       String?
  fiscalLegalForm       String?
  fiscalIdNumber        String?
  fiscalAddress         String?
  fiscalJurisdiction    String?
  fiscalRegime          String?
  fiscalExercice        String? // ex. "01/01-31/12"
  fiscalVatRegistered   Boolean @default(false)

  // Monétisation — champs admin-configurables, aucune valeur figée dans le code
  freeTrialStartedAt   DateTime?
  freeTrialDurationDays Int      @default(90) // décision #3 : 3 mois par défaut, modifiable en admin
  openingFeeWaived     Boolean  @default(true) // vrai tant que la phase gratuite est active
  openingFeePaidAt     DateTime?

  marketplaceBouquetId String?
  marketplaceBouquet    SubscriptionPlan? @relation("MarketplaceBouquet", fields: [marketplaceBouquetId], references: [id])
  gestionBouquetId      String?
  gestionBouquet         SubscriptionPlan? @relation("GestionBouquet", fields: [gestionBouquetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff          ShopStaff[]
  products       Product[]
  stockMovements StockMovement[]
  posSales       PosSale[]
  orders         ShopOrder[]
  invoices       CommercialDocument[]
  suppliers      Supplier[]
  expenses       Expense[]
  customers      ShopCustomer[]
  subscriptions  ShopSubscription[]
  platformInvoices Invoice[]
  creditWallet   AiCreditWallet?
  auditLogs      AuditLog[]
  reviews        Review[]
  variantOptions VariantOption[]
  shopDrivers    ShopDriver[]
  fiscalRules    FiscalRule[]
  accounts       Account[]
  journals       Journal[]
  journalEntries JournalEntry[]
  assets         Asset[]
  accountingClosures AccountingClosure[]
  comptesTresorerie TresorerieCompte[]
  relances       Relance[]
  receptionsStock ReceptionStock[]
  conversations  Conversation[]
  deliveryZones  ShopDeliveryZone[]

  // Module Experts (16 oct. 2026, point 2)
  expertInvites      ShopExpertInvite[]
  expertEngagements  ShopExpertEngagement[]

  // Business plan / dossier crédit (16 oct. 2026, point 1)
  businessPlans BusinessPlan[]
}

model ShopStaff {
  id       String    @id @default(uuid())
  shopId   String
  shop     Shop      @relation(fields: [shopId], references: [id])
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  role     StaffRole
  active   Boolean   @default(true)
  createdAt DateTime @default(now())

  @@unique([shopId, userId])
}

// ---------------------------------------------------------------------------
// MODULE EXPERTS — demande du 16 oct. 2026, point 2 : offrir au secteur
// informel un accès à de l'expertise/contre-expertise freelance (montage de
// dossier crédit, risque, compliance, analyste crédit, etc.), modéré par un
// admin avant d'apparaître dans l'annuaire public, invité par lien (compte
// ELEGANZ existant requis — décision verrouillée), avec des accès à la
// plateforme de la boutique accordés par périmètre choisi au cas par cas
// (jamais un accès fixe identique pour tous — décision verrouillée) et
// révocables à tout moment depuis la gestion d'équipe. Conditions d'exercice
// de l'expert affichées à titre informatif uniquement, aucune passerelle de
// paiement (décision verrouillée).
// ---------------------------------------------------------------------------

enum ExpertStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

// Présentation publique du profil (demande du 16 oct. 2026) — l'expert
// choisit un gabarit visuel pour son profil public ; purement une question
// d'affichage côté web (couleurs, mise en page), jamais de contenu différent
// selon le gabarit.
enum ExpertProfileTemplate {
  CLASSIQUE
  MODERNE
  CREATIF
}

// Profil de candidature/expert — tout utilisateur ELEGANZ peut postuler,
// quel que soit son rôle ; seul un statut APPROVED est visible dans
// l'annuaire public (/experts).
model ExpertProfile {
  id           String                @id @default(uuid())
  userId       String                @unique
  user         User                  @relation(fields: [userId], references: [id])
  headline     String
  bio          String                @db.Text
  domaines     String[] // ex. ["Montage dossier crédit", "Risque", "Compliance"]
  conditions   String?               @db.Text // informatif seulement, jamais de paiement en ligne
  template     ExpertProfileTemplate @default(MODERNE)
  photoUrl     String?
  status       ExpertStatus          @default(PENDING_REVIEW)
  statusNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  engagements ShopExpertEngagement[]
  invites     ShopExpertInvite[]
  documents   ExpertDocument[]
  references  ExpertReference[]

  @@index([status])
}

// Pièces de la candidature (demande du 16 oct. 2026, point 3) — CV,
// diplômes, certifications et tout autre document utile à la modération
// admin. Non publiées dans l'annuaire public (données personnelles) : vues
// uniquement par l'expert lui-même et par l'administration ELEGANZ.
enum ExpertDocumentType {
  CV
  DIPLOME
  CERTIFICATION
  AUTRE
}

model ExpertDocument {
  id              String             @id @default(uuid())
  expertProfileId String
  expertProfile   ExpertProfile      @relation(fields: [expertProfileId], references: [id])
  type            ExpertDocumentType
  label           String
  url             String
  createdAt       DateTime           @default(now())

  @@index([expertProfileId])
}

// Personnes de référence à contacter (demande du 16 oct. 2026, point 3) —
// mêmes règles de confidentialité que ExpertDocument : jamais publiées.
model ExpertReference {
  id              String        @id @default(uuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id])
  fullName        String
  role            String?
  contact         String
  note            String?       @db.Text
  createdAt       DateTime      @default(now())

  @@index([expertProfileId])
}

// Périmètres d'accès qu'une boutique peut accorder à un expert — un accès
// toujours choisi par la boutique, jamais déduit automatiquement du domaine
// déclaré par l'expert (décision verrouillée du 16 oct. 2026).
enum ShopExpertScope {
  FINANCE
  COMMANDES
  CATALOGUE
}

enum ShopExpertInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Lien d'invitation généré par une boutique (gestion d'équipe) — l'expert
// doit déjà avoir un compte ELEGANZ pour l'accepter (décision verrouillée :
// pas de création de compte à la volée depuis ce lien).
model ShopExpertInvite {
  id              String                 @id @default(uuid())
  token           String                 @unique
  shopId          String
  shop            Shop                   @relation(fields: [shopId], references: [id])
  createdByUserId String
  createdBy       User                   @relation("ExpertInviteCreatedBy", fields: [createdByUserId], references: [id])
  scopes          ShopExpertScope[]
  status          ShopExpertInviteStatus @default(PENDING)
  expertProfileId String?
  expertProfile   ExpertProfile?         @relation(fields: [expertProfileId], references: [id])
  expiresAt       DateTime
  createdAt       DateTime               @default(now())

  @@index([shopId])
}

enum ShopExpertEngagementStatus {
  ACTIVE
  REVOKED
}

// Accès effectivement accordé une fois l'invitation acceptée — révocable à
// tout moment depuis la gestion d'équipe de la boutique.
model ShopExpertEngagement {
  id              String                     @id @default(uuid())
  shopId          String
  shop            Shop                       @relation(fields: [shopId], references: [id])
  expertProfileId String
  expertProfile   ExpertProfile              @relation(fields: [expertProfileId], references: [id])
  scopes          ShopExpertScope[]
  status          ShopExpertEngagementStatus @default(ACTIVE)
  invitedByUserId String
  invitedBy       User                       @relation("ExpertEngagementInvitedBy", fields: [invitedByUserId], references: [id])
  createdAt       DateTime                   @default(now())
  revokedAt       DateTime?

  @@unique([shopId, expertProfileId])
  @@index([shopId])
}

// ---------------------------------------------------------------------------
// CATALOGUE & STOCK — commun aux ventes physiques et en ligne
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  name        String
  description String?
  category    String?
  images      String[] // URLs stockage objet
  isPublished Boolean  @default(false) // bascule "Publier sur ELEGANZ"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants Variant[]
  reviews  Review[]
}

enum VariantOptionKind {
  SIZE
  COLOR
}

// Valeurs prédéfinies de taille/couleur propres à chaque boutique (demande
// du 12 oct. 2026) — remplace la saisie libre par une liste déroulante à
// choix multiple côté catalogue, pour éviter les doublons dus à des fautes
// de frappe ("Rouge" / "rouge " / "ROUGE"). Chaque boutique construit sa
// propre liste au fil de l'eau ; aucune valeur n'est imposée globalement.
model VariantOption {
  id        String            @id @default(uuid())
  shopId    String
  shop      Shop              @relation(fields: [shopId], references: [id])
  kind      VariantOptionKind
  value     String
  createdAt DateTime          @default(now())

  @@unique([shopId, kind, value])
}

model Variant {
  id          String  @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  sku         String  @unique
  size        String?
  color       String?
  costPrice   Decimal? @db.Decimal(12, 2) // prix d'achat — jamais exposé aux autres vendeurs
  sellPrice   Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD") // USD ou CDF
  stockQty    Int      @default(0)
  lowStockAt  Int      @default(3)

  stockMovements StockMovement[]
  saleLines      PosSaleLine[]
  orderLines     OrderLine[]
  receptions     ReceptionStock[]

  // Coût unitaire moyen pondéré (CUMP) — ajouté le 14 oct. 2026 (chantier
  // SYSCOHADA, phase 4 : stock & CMV). `null` tant qu'aucune réception
  // valorisée n'a eu lieu pour cette variante, y compris pour tout le stock
  // déjà en cours à cette date — jamais une valeur inventée
  // rétroactivement. Recalculé par StockValorisationService à chaque
  // réception : (ancienneValeur + qté×coûtUnitaire) / (ancienneQté + qté).
  coutMoyenPondere Decimal? @db.Decimal(12, 4)
}

enum StockMovementType {
  PURCHASE_IN
  POS_SALE_OUT
  ONLINE_SALE_OUT
  ONLINE_SALE_RESERVED // réservation le temps du paiement, pour éviter la double vente
  RETURN_IN
  ADJUSTMENT
  DEFECTIVE_OUT
}

// Table transactionnelle : toute variation de stock (caisse ou Marketplace) passe par ici.
// C'est le point d'unicité qui empêche la double vente décrite dans le cahier des charges.
model StockMovement {
  id        String            @id @default(uuid())
  shopId    String
  shop      Shop              @relation(fields: [shopId], references: [id])
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id])
  type      StockMovementType
  quantity  Int // signé : négatif pour une sortie
  reference String? // id de la vente / commande / achat liés
  createdAt DateTime          @default(now())

  // Valorisation CUMP — ajoutés le 14 oct. 2026 (chantier SYSCOHADA, phase
  // 4). `null` pour tout mouvement non valorisé (comportement identique à
  // avant ce chantier) ; `valeur` porte le même signe que `quantity`
  // (négatif pour une sortie), pour que la somme des `valeur` sur une
  // période donne directement le CMV de la période.
  coutUnitaire Decimal? @db.Decimal(12, 4)
  valeur       Decimal? @db.Decimal(12, 2)
}

// Réception de stock valorisée (14 oct. 2026, chantier SYSCOHADA phase 4) —
// le seul point d'entrée qui fait réellement progresser le CUMP d'une
// variante. Un achat fournisseur (modèle Purchase, montant global) peut
// exister sans ligne de réception (comme avant ce chantier) ; une
// réception, elle, nécessite toujours une quantité et un coût unitaire.
model ReceptionStock {
  id           String   @id @default(uuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id])
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id])
  quantity     Int
  coutUnitaire Decimal  @db.Decimal(12, 4)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  onCredit     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([shopId, variantId])
}

// ---------------------------------------------------------------------------
// ELEGANZ GESTION — caisse, vente physique, documents commerciaux
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  STORE_CREDIT
  CASH_ON_DELIVERY
}

model PosSale {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  cashierId   String
  cashier     User     @relation("CashierSales", fields: [cashierId], references: [id])
  customerId  String?
  customer    ShopCustomer? @relation(fields: [customerId], references: [id])
  totalAmount Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  status      String   @default("COMPLETED") // COMPLETED | CANCELLED | RETURNED
  // Clé d'idempotence pour la synchronisation hors-ligne (docs/ARCHITECTURE_HORS_LIGNE.md) :
  // générée côté client avant tout appel réseau, unique, pour qu'une
  // tentative renvoyée deux fois ne crée jamais deux ventes.
  clientOperationId String? @unique
  createdAt   DateTime @default(now())

  lines     PosSaleLine[]
  payments  PosPayment[]
  documents CommercialDocument[]
}

model PosSaleLine {
  id        String   @id @default(uuid())
  saleId    String
  sale      PosSale  @relation(fields: [saleId], references: [id])
  variantId String?  // vide si vente rapide d'un article non catalogué
  variant   Variant? @relation(fields: [variantId], references: [id])
  label     String   // désignation libre pour une vente non cataloguée
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  // true quand cette ligne a été acceptée en synchronisation différée alors
  // que le stock disponible était insuffisant (décision validée par le
  // propriétaire : on garde la vente — l'argent a réellement été encaissé —
  // et on laisse le stock descendre sous zéro plutôt que d'effacer une
  // transaction physique déjà survenue). La boutique régularise elle-même.
  stockDiscrepancy Boolean @default(false)
}

model PosPayment {
  id        String        @id @default(uuid())
  saleId    String
  sale      PosSale       @relation(fields: [saleId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  confirmed Boolean       @default(true) // false = déclaré manuellement, non confirmé par un prestataire
}

enum DocumentType {
  TICKET
  RECEIPT
  INVOICE_INTERNAL      // document commercial ordinaire, NON homologué
  INVOICE_FISCAL        // facture normalisée via MCF/e-DEF, une fois homologuée
  PROFORMA
  QUOTE
  CREDIT_NOTE
  DELIVERY_NOTE
}

model CommercialDocument {
  id        String       @id @default(uuid())
  shopId    String
  shop      Shop         @relation(fields: [shopId], references: [id])
  posSaleId String?
  posSale   PosSale?     @relation(fields: [posSaleId], references: [id])
  shopOrderId String?
  shopOrder ShopOrder?   @relation(fields: [shopOrderId], references: [id])
  type      DocumentType
  number    String       @unique
  isFiscallyHomologated Boolean @default(false) // ne jamais passer à true sans homologation DGI vérifiée
  pdfUrl    String?
  createdAt DateTime     @default(now())
}

model Supplier {
  id      String @id @default(uuid())
  shopId  String
  shop    Shop   @relation(fields: [shopId], references: [id])
  name    String
  phone   String?
  balanceOwed Decimal @default(0) @db.Decimal(12, 2) // dettes fournisseur

  purchases Purchase[]
  relances  Relance[]
  receptionsStock ReceptionStock[]
}

model Purchase {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  // Conservé sur l'achat lui-même depuis le 13 oct. 2026 (moteur comptable,
  // docs/ARCHITECTURE_FINANCE.md §8bis.4) — jusqu'ici seul
  // Supplier.balanceOwed était mis à jour, sans garder trace par achat.
  // Défaut false pour l'historique déjà enregistré (hypothèse "payé", la
  // plus sûre pour ne pas inventer une dette fournisseur rétroactive).
  onCredit   Boolean  @default(false)
  receivedAt DateTime?
  createdAt  DateTime @default(now())

  // Ajouté le 14 oct. 2026 — chantier SYSCOHADA, phase 3 (créances &
  // dettes). `null` pour tout l'historique déjà enregistré : aucune
  // échéance n'est inventée rétroactivement.
  dueDate    DateTime?
  reglements ReglementFournisseur[]
}

// Règlements et relances (créances & dettes) — 14 oct. 2026, chantier
// SYSCOHADA phase 3. Le "lettrage" ici est volontairement simple : un
// règlement référence explicitement l'achat ou le client concerné (saisie
// par l'utilisateur), ce n'est jamais un algorithme de rapprochement
// automatique entre plusieurs pièces — à ne pas présenter comme tel.
model ReglementFournisseur {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  paidAt     DateTime
  method     String?
  createdAt  DateTime @default(now())

  @@index([purchaseId])
}

model ReglementClient {
  id         String       @id @default(uuid())
  customerId String
  customer   ShopCustomer @relation(fields: [customerId], references: [id])
  amount     Decimal      @db.Decimal(12, 2)
  paidAt     DateTime
  method     String?
  createdAt  DateTime     @default(now())

  @@index([customerId])
}

enum RelanceDirection {
  CLIENT
  FOURNISSEUR
}

// Relance = un rappel JOURNALISÉ par l'utilisateur (pas d'envoi réel de
// SMS/email à cette phase — ce serait présenter comme construit un canal de
// notification qui n'existe pas).
model Relance {
  id         String           @id @default(uuid())
  shopId     String
  shop       Shop             @relation(fields: [shopId], references: [id])
  direction  RelanceDirection
  customerId String?
  customer   ShopCustomer?    @relation(fields: [customerId], references: [id])
  supplierId String?
  supplier   Supplier?        @relation(fields: [supplierId], references: [id])
  message    String
  envoyeeAt  DateTime         @default(now())
  createdBy  String?

  @@index([shopId])
}

model Expense {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  category  String   // loyer, transport, salaires, électricité, télécom, livraison, autre
  amount    Decimal  @db.Decimal(12, 2)
  // Devise de la dépense (Finance & Comptabilité, 13 oct. 2026) — absente
  // jusqu'ici, contrairement à PosSale.currency ; défaut "USD" pour ne pas
  // réinterpréter silencieusement les dépenses déjà enregistrées.
  currency  String   @default("USD")
  note      String?
  createdAt DateTime @default(now())
}

model ShopCustomer {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  fullName    String
  phone       String?
  creditBalance Decimal @default(0) @db.Decimal(12, 2) // créances dues par ce client

  sales      PosSale[]
  reglements ReglementClient[]
  relances   Relance[]
}

// ---------------------------------------------------------------------------
// ELEGANZ MARKETPLACE — commandes en ligne multivendeurs
// ---------------------------------------------------------------------------

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED_DECLARED   // déclaré livré par le livreur
  RECEIVED_CONFIRMED   // confirmé reçu par le client — événement distinct
  CLOSED
  CANCELLED
  RETURN_REQUESTED
  REFUNDED
  DISPUTED
}

// Commande globale du client (peut couvrir plusieurs boutiques)
model Order {
  id        String      @id @default(uuid())
  buyerId   String
  buyer     User        @relation(fields: [buyerId], references: [id])
  totalAmount Decimal   @db.Decimal(12, 2)
  currency  String      @default("USD")
  createdAt DateTime    @default(now())

  // Coordonnées de livraison saisies au moment de la commande (prompt du
  // 12 oct. 2026) — la boutique en a besoin pour joindre le client et
  // organiser la livraison, au-delà du compte acheteur lui-même.
  // whatsappPhone en priorité (canal de contact préféré en RDC) ; phone en
  // repli si le client n'a pas WhatsApp.
  buyerWhatsapp    String?
  buyerPhone       String?
  deliveryCommune  String?
  deliveryQuartier String?
  deliveryAvenue   String?
  deliveryRepere   String?
  deliveryNote     String?

  shopOrders ShopOrder[]
  payments   OrderPayment[]
}

// Sous-commande par boutique — chaque vendeur ne voit que la sienne
model ShopOrder {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  shopId    String
  shop      Shop        @relation(fields: [shopId], references: [id])
  status    OrderStatus @default(CREATED)
  subtotal  Decimal     @db.Decimal(12, 2)
  // Calculée à la création (OrdersService.createOrder) à partir du taux de
  // commission du bouquet Marketplace de la boutique, ou du taux par défaut
  // de la plateforme (14 oct. 2026, plan commercial). `commissionInvoicedAt`
  // marque qu'elle a déjà été incluse dans une facture de commission
  // (BillingService.runCommissionBilling) — évite de la facturer deux fois.
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  commissionInvoicedAt DateTime?
  // Réseau de livreurs plateforme (Driver) — fermé au grand public depuis le
  // 13 oct. 2026, conservé tel quel pour une réouverture future. Les
  // nouvelles affectations passent par shopDriverId ci-dessous.
  driverId  String?
  driver    Driver?     @relation(fields: [driverId], references: [id])
  // Livreur propre à la boutique (13 oct. 2026, 1ʳᵉ demande du jour) : pas
  // de compte ELEGANZ, pas de vérification plateforme — sous la seule
  // responsabilité de la boutique qui l'a enregistré. Une sous-commande n'a
  // jamais les deux à la fois en pratique (voir DeliveryService.assignDriver
  // / assignShopDriver), mais les deux champs restent indépendants dans le
  // schéma pour ne pas invalider l'historique si le réseau plateforme rouvre.
  shopDriverId String?
  shopDriver   ShopDriver? @relation(fields: [shopDriverId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lines         OrderLine[]
  documents     CommercialDocument[]
  dispute       Dispute?
  reviews       Review[]
  statusEvents  OrderStatusEvent[]
}

// Horodatage de chaque changement de statut d'une sous-commande (demande du
// 12 oct. 2026, point 4 — suivi des SLA et du comportement des acteurs).
// ShopOrder.status ne garde que le statut courant ; sans cette table il est
// impossible de savoir, par exemple, combien de temps une boutique met en
// moyenne pour accepter une commande. N'existe qu'à partir du déploiement de
// cette fonctionnalité — les commandes déjà closes avant cette date n'ont
// pas d'historique rétroactif, seulement leur statut final.
model OrderStatusEvent {
  id          String      @id @default(uuid())
  shopOrderId String
  shopOrder   ShopOrder   @relation(fields: [shopOrderId], references: [id])
  status      OrderStatus
  occurredAt  DateTime    @default(now())

  @@index([shopOrderId])
}

model OrderLine {
  id        String  @id @default(uuid())
  shopOrderId String
  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
}

model OrderPayment {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  method    PaymentMethod
  provider  String?       // "moneroo", "orange_direct", "cash_on_delivery", ...
  amount    Decimal       @db.Decimal(12, 2)
  confirmed Boolean       @default(false)
  providerRef String?
  createdAt DateTime      @default(now())
}

model Dispute {
  id          String    @id @default(uuid())
  shopOrderId String    @unique
  shopOrder   ShopOrder @relation(fields: [shopOrderId], references: [id])
  reason      String
  status      String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED
  resolution  String?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// AVIS, COMMENTAIRES & TÉMOIGNAGES — crédibilité de la plateforme (prompt du
// 12 oct. 2026). Un avis cible toujours une boutique, et optionnellement un
// article précis. `shopOrderId`, quand renseigné, rattache l'avis à une
// commande réelle de l'auteur — `verifiedPurchase` est calculé une seule
// fois à la création à partir du statut de cette commande (voir le champ
// plus bas), jamais déduit de la seule déclaration du client.
model Review {
  id          String    @id @default(uuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  shopOrderId String?
  shopOrder   ShopOrder? @relation(fields: [shopOrderId], references: [id])
  rating      Int // 1 à 5
  comment     String?
  // Calculé une seule fois à la création, à partir du statut de la commande
  // liée (RECEIVED_CONFIRMED ou CLOSED) — pas recalculé ensuite : un retour
  // tardif sur une commande déjà close ne doit pas faire disparaître
  // rétroactivement un avis déjà publié et lu.
  verifiedPurchase Boolean @default(false)
  isPublished Boolean   @default(true) // modération a posteriori (admin), jamais pré-modéré
  createdAt   DateTime  @default(now())

  @@unique([authorId, shopOrderId])
}

// ---------------------------------------------------------------------------
// LIVRAISON
// ---------------------------------------------------------------------------

enum DriverVehicleType {
  PIED
  VELO
  MOTO
  VOITURE
}

model Driver {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  zone      String?
  verified  Boolean  @default(false)

  // Informations à fournir à l'inscription pour que l'administration puisse
  // instruire le dossier avant de valider la souscription (prompt du
  // 13 oct. 2026, point 2) — toutes facultatives au niveau du schéma (pour
  // ne pas invalider les livreurs déjà inscrits avant ce champ) ; la DTO
  // d'inscription (RegisterDriverDto) les exige selon le type de véhicule
  // déclaré : plaque + permis obligatoires en moto/voiture, pas à pied/vélo.
  phone            String?
  whatsapp         String?
  address          String?
  vehicleType      DriverVehicleType?
  vehiclePlate     String?
  licenseNumber    String?
  idDocumentNumber String?
  // Note interne de l'administration pendant l'instruction du dossier (ex.
  // "pièce d'identité illisible, à refaire") — jamais visible du livreur.
  adminNote        String?

  // Facturation de l'espace livreur (prompt du 13 oct. 2026, point 1) —
  // indépendante de `verified` (identité/dossier) : un livreur peut être
  // vérifié mais suspendu pour impayé, ou inversement en attente de
  // vérification alors que sa période gratuite tourne déjà. `freeTrialStartedAt`
  // n'est renseigné qu'au moment où l'admin valide le dossier (verified=true
  // pour la première fois), jamais à l'inscription elle-même.
  billingStatus      DriverBillingStatus @default(FREE_PERIOD)
  freeTrialStartedAt DateTime?

  deliveries ShopOrder[]
  invoices   DriverInvoice[]
}

enum DriverBillingStatus {
  FREE_PERIOD  // période de gratuité en cours, pas encore facturé
  PAYMENT_DUE  // gratuité écoulée, facture(s) en attente de règlement
  ACTIVE       // à jour de ses paiements
  SUSPENDED    // impayé au-delà du délai de grâce — missions bloquées
}

// Livreur propre à une boutique (13 oct. 2026, 1ʳᵉ demande du jour — en
// remplacement du réseau de livreurs plateforme, fermé au grand public pour
// limiter le risque de malhonnêteté au lancement). Pas de compte ELEGANZ :
// une simple fiche gérée par la boutique elle-même, sous sa propre
// responsabilité en cas de perte ou de vol — jamais celle de la plateforme.
// Le personnel de boutique marque lui-même les étapes de livraison (via
// PATCH /shops/:shopId/orders/:shopOrderId/status, déjà existant), puisque
// ce livreur n'a pas de compte pour confirmer ses propres étapes.
model ShopDriver {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  fullName    String
  phone       String?
  vehicleType String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  deliveries ShopOrder[]

  @@index([shopId])
}

model DeliveryZone {
  id       String  @id @default(uuid())
  commune  String
  fee      Decimal @db.Decimal(12, 2)
  active   Boolean @default(true)
}

// ---------------------------------------------------------------------------
// MONÉTISATION — bouquets, abonnements, crédits IA (100 % administrables)
// ---------------------------------------------------------------------------

enum PlanCategory {
  MARKETPLACE
  GESTION
}

model SubscriptionPlan {
  id             String       @id @default(uuid())
  category       PlanCategory
  name           String
  // Frais unique à la souscription (14 oct. 2026, plan commercial) — avant
  // ce champ, BillingService.processTrialExpirations facturait 100 $ à
  // toute boutique, quel que soit son bouquet. Par défaut 0 pour ne rien
  // changer au comportement des bouquets déjà créés avant ce champ.
  openingFee     Decimal      @default(0) @db.Decimal(12, 2)
  monthlyPrice   Decimal      @db.Decimal(12, 2)
  maxActiveProducts Int?
  // Taux de commission (%) sur les transactions ELEGANZ Market, pour un
  // bouquet MARKETPLACE (14 oct. 2026, plan commercial — second levier de
  // revenu demandé par le propriétaire, au-delà de l'abonnement mensuel).
  // Nullable : quand absent, OrdersService retombe sur
  // PlatformSettings.marketplaceCommissionRateDefault, puis sur 0 si ce
  // dernier est lui aussi absent — jamais un taux inventé.
  commissionRate Decimal?     @db.Decimal(5, 2)
  featuresJson   Json         // liste des fonctionnalités incluses, éditable en admin
  active         Boolean      @default(true)

  marketplaceShops Shop[] @relation("MarketplaceBouquet")
  gestionShops     Shop[] @relation("GestionBouquet")
  subscriptions    ShopSubscription[]
}

model ShopSubscription {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  startedAt DateTime @default(now())
  renewsAt  DateTime?
  status    String   @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELLED
}

model Invoice {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  dueAt     DateTime
  paidAt    DateTime?
  status    String   @default("PENDING") // PENDING | PAID | OVERDUE | WAIVED
  kind      String   // "opening_fee" | "subscription" | "ai_credits" | ...
  createdAt DateTime @default(now())

  aiCreditTopUp AiCreditTopUp?
}

model DriverInvoice {
  id        String   @id @default(uuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  dueAt     DateTime
  paidAt    DateTime?
  status    String   @default("PENDING") // PENDING | PAID | OVERDUE | WAIVED
  kind      String   // "opening_fee" | "subscription"
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// ELEGANZ MON COMPTABLE — carnet de gestion quotidienne (prompt du
// 13 oct. 2026, mission complémentaire). Module fonctionnellement autonome
// (aucune boutique ni catalogue requis) mais rattaché au compte ELEGANZ
// commun : chaque modèle ci-dessous part de `User`, jamais de `Shop`. Les
// montants restent toujours dans leur devise d'origine (CDF ou USD) — on ne
// fusionne jamais deux devises dans un même total sans conversion explicite
// (prompt §5), d'où `ComptableCurrency` répété sur chaque ligne plutôt
// qu'un total unique par activité.
// ---------------------------------------------------------------------------

enum ComptableCurrency {
  CDF
  USD
}

enum ComptableActivityCategory {
  COMMERCE
  LOCATION
  VEHICULE
  SERVICE
  AUTRE
}

model ComptableActivity {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  name       String
  category   ComptableActivityCategory
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  entries           ComptableEntry[]
  debts             ComptableDebt[]
  rentalUnits       ComptableRentalUnit[]
  workerRemittances ComptableWorkerRemittance[]
}

// Sens du flux — une vente et un emprunt reçu sont tous deux des ENTREE,
// mais ne doivent jamais être confondus dans l'analyse (prompt §6) : c'est
// `category`, pas `direction`, qui porte cette distinction.
enum ComptableFlowDirection {
  ENTREE
  SORTIE
}

enum ComptableFlowCategory {
  // Entrées
  VENTE
  PRESTATION
  LOYER_RECU
  REMBOURSEMENT_CREANCE
  APPORT_PERSONNEL
  EMPRUNT_RECU
  AUTRE_ENTREE
  // Sorties
  ACHAT
  TRANSPORT
  LOYER_PAYE
  ENTRETIEN
  REPARATION
  DEPENSE_FONCTIONNEMENT
  REMBOURSEMENT_DETTE
  AUTRE_SORTIE
}

// Une ligne de carnet (vente, dépense, loyer reçu...). La saisie simplifiée
// à une ligne par jour (prompt §5) crée jusqu'à 4 lignes ici (vente CDF,
// vente USD, dépense CDF, dépense USD) plutôt qu'un format dénormalisé —
// garde les statistiques par devise/catégorie fiables sans réécrire de
// logique d'agrégation séparée pour la saisie rapide.
model ComptableEntry {
  id          String   @id @default(uuid())
  activityId  String
  activity    ComptableActivity @relation(fields: [activityId], references: [id])
  date        DateTime // date réelle de l'opération (saisie rétroactive permise, prompt §5)
  direction   ComptableFlowDirection
  category    ComptableFlowCategory
  currency    ComptableCurrency
  amount      Decimal  @db.Decimal(14, 2)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Marqueur d'idempotence pour la saisie différée hors-ligne de Secourable
// (prompt du 13 oct. 2026, point 2 : "saisie différée synchronisée au retour
// du réseau") — même principe que PosSale.clientOperationId, mais sous forme
// de ligne séparée plutôt qu'un champ sur ComptableEntry, car une seule
// soumission de saisie rapide peut créer plusieurs ComptableEntry à la fois
// (ventes et dépenses CDF/USD en une fois) : on ne peut pas mettre la
// contrainte @unique sur plusieurs lignes nées de la même opération. Rejouer
// la synchronisation avec le même clientOperationId est donc un no-op sûr
// plutôt qu'un doublon.
model ComptableSyncMarker {
  id                String   @id @default(uuid())
  clientOperationId String   @unique
  userId            String
  createdAt         DateTime @default(now())
}

enum ComptableDebtType {
  DETTE   // ce que je dois payer
  CREANCE // ce que d'autres me doivent
  EMPRUNT // somme empruntée, avec ses propres modalités
}

model ComptableDebt {
  id               String   @id @default(uuid())
  activityId       String
  activity         ComptableActivity @relation(fields: [activityId], references: [id])
  type             ComptableDebtType
  counterpartyName String
  description      String?
  amount           Decimal  @db.Decimal(14, 2)
  currency         ComptableCurrency
  startDate        DateTime @default(now())
  dueDate          DateTime?
  settled          Boolean  @default(false)
  createdAt        DateTime @default(now())

  payments ComptableDebtPayment[]
}

model ComptableDebtPayment {
  id      String   @id @default(uuid())
  debtId  String
  debt    ComptableDebt @relation(fields: [debtId], references: [id])
  amount  Decimal  @db.Decimal(14, 2)
  paidAt  DateTime @default(now())
  note    String?
}

enum ComptableRentFrequency {
  MENSUEL
  TRIMESTRIEL
  ANNUEL
  PERSONNALISE
}

model ComptableRentalUnit {
  id            String   @id @default(uuid())
  activityId    String
  activity      ComptableActivity @relation(fields: [activityId], references: [id])
  label         String // désignation (ex. "Appartement 2, Lemba")
  location      String?
  tenantName    String?
  rentAmount    Decimal  @db.Decimal(14, 2)
  currency      ComptableCurrency
  frequency     ComptableRentFrequency @default(MENSUEL)
  leaseStart    DateTime?
  leaseEnd      DateTime?
  // Garantie locative — distincte des loyers encaissés (prompt §8), jamais
  // comptée dans les montants reçus/attendus d'une période.
  depositAmount Decimal? @db.Decimal(14, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  payments ComptableRentPayment[]
  expenses ComptableRentExpense[]
}

model ComptableRentPayment {
  id             String   @id @default(uuid())
  unitId         String
  unit           ComptableRentalUnit @relation(fields: [unitId], references: [id])
  periodLabel    String // ex. "Octobre 2026"
  expectedAmount Decimal  @db.Decimal(14, 2)
  receivedAmount Decimal  @default(0) @db.Decimal(14, 2)
  dueDate        DateTime
  paidAt         DateTime?
  note           String?
  createdAt      DateTime @default(now())
}

model ComptableRentExpense {
  id         String   @id @default(uuid())
  unitId     String
  unit       ComptableRentalUnit @relation(fields: [unitId], references: [id])
  category   String // entretien | réparation | travaux | gardiennage | eau | électricité | autre
  amount     Decimal  @db.Decimal(14, 2)
  currency   ComptableCurrency
  date       DateTime @default(now())
  note       String?
}

// Suivi des versements d'un travailleur confié à une activité (prompt §9) —
// `paidAmount` est ce que le travailleur a réellement remis au propriétaire ;
// `declaredRevenue`/`declaredExpenses` restent déclaratifs, jamais vérifiés
// automatiquement. Un transfert entre la caisse du travailleur et celle du
// propriétaire reste ici, hors de ComptableEntry, pour ne jamais être compté
// deux fois comme un revenu (prompt §9).
model ComptableWorkerRemittance {
  id               String   @id @default(uuid())
  activityId       String
  activity         ComptableActivity @relation(fields: [activityId], references: [id])
  workerName       String
  periodLabel      String
  expectedAmount   Decimal? @db.Decimal(14, 2)
  declaredRevenue  Decimal? @db.Decimal(14, 2)
  declaredExpenses Decimal? @db.Decimal(14, 2)
  paidAmount       Decimal  @default(0) @db.Decimal(14, 2)
  currency         ComptableCurrency
  dueDate          DateTime?
  settledAt        DateTime?
  note             String?
  createdAt        DateTime @default(now())
}

enum ComptableBillingStatus {
  FREE_PERIOD
  PAYMENT_DUE
  ACTIVE
  SUSPENDED
}

// Un seul abonnement Secourable par compte ELEGANZ (prompt §3 : compte
// commun), partagé par toutes les activités de l'utilisateur — jamais un
// abonnement par activité. `freeTrialStartedAt` n'est posé qu'à la première
// activation effective (prompt §14), pas à la création du compte ELEGANZ.
model ComptableSubscription {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  billingStatus      ComptableBillingStatus @default(FREE_PERIOD)
  activatedAt        DateTime @default(now())
  freeTrialStartedAt DateTime @default(now())
  plan               String? // "MONTHLY" | "YEARLY" — choisi à la première échéance
  renewsAt           DateTime?
  createdAt          DateTime @default(now())

  // Bouquet tarifaire Secourable (14 oct. 2026, proposition validée par
  // le propriétaire) — distinct de `plan` ci-dessus, qui ne porte que la
  // fréquence de facturation (mensuel/annuel), jamais le palier de
  // fonctionnalités. Nullable pour la migration : un abonnement déjà actif
  // avant ce champ est automatiquement rattaché au bouquet "Pro" (jamais
  // "Essentiel") pour ne perdre aucun accès déjà utilisé — voir
  // ComptablePlansService.rattacherAbonnesSansBouquet, même principe que
  // SubscriptionPlansService côté ELEGANZ Gestion.
  bouquetId String?
  bouquet   ComptablePlan? @relation(fields: [bouquetId], references: [id])

  invoices ComptableInvoice[]
}

// Bouquets tarifaires Secourable (14 oct. 2026, proposition validée par
// le propriétaire — voir docs/PLAN_COMMERCIAL.md). Contrairement à
// SubscriptionPlan (lié à une Shop), un bouquet Secourable se rattache à
// un ComptableSubscription (donc à un utilisateur, pas une boutique) — un
// modèle séparé plutôt que de réutiliser SubscriptionPlan, dont les champs
// (maxActiveProducts, commissionRate, relations à Shop) n'ont aucun sens ici.
model ComptablePlan {
  id            String   @id @default(uuid())
  name          String
  monthlyPrice  Decimal  @db.Decimal(12, 2)
  yearlyPrice   Decimal  @db.Decimal(12, 2)
  // Nombre d'activités suivies simultanément (archivées non comptées) ;
  // null = illimité.
  maxActivities Int?
  // { historiqueIllimite, comparaisonPeriodes, rappelsAgenda,
  // exportDossierFinancement } — toutes booléennes, lues par ComptableService
  // et ComptableController, éditables depuis /admin/tarifs sans redéploiement.
  featuresJson  Json
  active        Boolean  @default(true)

  subscriptions ComptableSubscription[]
}

model ComptableInvoice {
  id             String   @id @default(uuid())
  subscriptionId String
  subscription   ComptableSubscription @relation(fields: [subscriptionId], references: [id])
  amount         Decimal  @db.Decimal(12, 2)
  dueAt          DateTime
  paidAt         DateTime?
  status         String   @default("PENDING") // PENDING | PAID | OVERDUE | WAIVED
  kind           String   // "monthly" | "yearly"
  createdAt      DateTime @default(now())
}

model AiCreditWallet {
  id        String  @id @default(uuid())
  shopId    String  @unique
  shop      Shop    @relation(fields: [shopId], references: [id])
  balance   Int     @default(0)

  transactions AiCreditTransaction[]
  topUps       AiCreditTopUp[]
}

model AiCreditTransaction {
  id        String   @id @default(uuid())
  walletId  String
  wallet    AiCreditWallet @relation(fields: [walletId], references: [id])
  delta     Int // négatif = consommation, positif = achat/remboursement
  service   String // "image_optimization" | "ad_generation" | "video_generation" | "top_up" | ...
  createdAt DateTime @default(now())
}

// Demande d'achat de crédits IA (14 oct. 2026, plan commercial — services à
// la carte) : une boutique demande `quantity` crédits, une Invoice{kind:
// "ai_credits"} est créée pour le montant correspondant (`quantity *
// PlatformSettings.aiCreditUnitPrice` au moment de la demande, jamais
// recalculé ensuite), et les crédits ne sont accordés au portefeuille
// qu'une fois cette facture marquée payée par un administrateur — même
// principe manuel que les autres cycles de facturation du projet, pas de
// crédit automatique avant paiement confirmé.
model AiCreditTopUp {
  id        String          @id @default(uuid())
  walletId  String
  wallet    AiCreditWallet  @relation(fields: [walletId], references: [id])
  quantity  Int
  invoiceId String          @unique
  invoice   Invoice         @relation(fields: [invoiceId], references: [id])
  createdAt DateTime        @default(now())
}

model AiService {
  id          String  @id @default(uuid())
  name        String
  description String?
  creditCost  Int
  active      Boolean @default(true)
  provider    String? // fournisseur technique
}

// ---------------------------------------------------------------------------
// AUDIT — traçabilité obligatoire des actions sensibles (prompt §41)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  shopId    String?
  shop      Shop?    @relation(fields: [shopId], references: [id])
  action    String
  details   Json?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// FINANCE & COMPTABILITÉ (prompt du 13 oct. 2026) — voir docs/ARCHITECTURE_FINANCE.md
// ---------------------------------------------------------------------------

// Une seule table pour les deux niveaux "boutique" et "ELEGANZ elle-même"
// (§15 du prompt exige 3 niveaux : référentiel central, boutique, ELEGANZ ;
// le référentiel central n'est pas encore modélisé séparément à cette phase,
// voir docs/ARCHITECTURE_FINANCE.md §7). La séparation stricte exigée par le
// prompt ("dans le modèle de données et les contrôles d'accès, pas
// seulement dans l'affichage") est appliquée au niveau service/contrôleur :
// les routes boutique ne touchent jamais scope=PLATFORM, les routes admin
// ne touchent jamais scope=SHOP — jamais une simple confiance dans l'UI.
enum FiscalRuleScope {
  SHOP
  PLATFORM
}

enum FiscalRuleCategory {
  TVA
  IMPOT
  RETENUE
  CONTRIBUTION
  AUTRE
}

// Statuts du §5.5 du prompt. VERIFIEE existe dans le modèle mais n'a pas
// encore de flux d'invitation de professionnel réel à cette phase (voir
// docs/ARCHITECTURE_FINANCE.md §7) — n'atteindre ce statut que par bascule
// manuelle documentée comme limite, jamais présenté comme une vérification
// professionnelle réellement effectuée par le système.
enum FiscalRuleStatus {
  PROPOSEE
  CONFIGUREE
  VERIFIEE
  OBSOLETE
}

model FiscalRule {
  id               String             @id @default(uuid())
  scope            FiscalRuleScope
  shopId           String?
  shop             Shop?              @relation(fields: [shopId], references: [id])
  label            String
  category         FiscalRuleCategory
  rateOrFormula    String
  baseCalcul       String?
  champApplication String?
  regime           String?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  sourceReference  String?
  status           FiscalRuleStatus   @default(PROPOSEE)
  lastModifiedBy   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  versions FiscalRuleVersion[]

  @@index([shopId])
  @@index([scope])
}

// Historique de versions (§5.7 du prompt) — jamais d'effacement silencieux :
// chaque modification ajoute une ligne, ne réécrit jamais l'ancienne.
model FiscalRuleVersion {
  id            String           @id @default(uuid())
  ruleId        String
  rule          FiscalRule       @relation(fields: [ruleId], references: [id])
  oldValue      Json?
  newValue      Json
  authorId      String?
  motif         String?
  effectiveDate DateTime
  status        FiscalRuleStatus
  createdAt     DateTime         @default(now())

  @@index([ruleId])
}

// ---------------------------------------------------------------------------
// MOTEUR DE COMPTABILITÉ EN PARTIE DOUBLE (13 oct. 2026, Phase 2 — voir
// docs/ARCHITECTURE_FINANCE.md §8bis). Reprend le patron déjà validé pour
// FiscalRule : un seul jeu de modèles, séparé par scope (SHOP/PLATFORM) +
// shopId nullable, isolation imposée côté service/contrôleur, jamais
// seulement par l'affichage. Volontairement minimal : assez pour un journal
// général, un grand livre et une balance réels — pas de clôture, pas d'états
// financiers réglementaires (toujours listés comme différés).
// ---------------------------------------------------------------------------

enum AccountNormalSide {
  DEBIT
  CREDIT
}

model Account {
  id            String            @id @default(uuid())
  scope         FiscalRuleScope
  shopId        String?
  shop          Shop?             @relation(fields: [shopId], references: [id])
  code          String // ex. "571", "701", "601" (SYSCOHADA révisé)
  label         String
  normalSide    AccountNormalSide
  // true pour les comptes seedés automatiquement par AccountingSeedService,
  // false pour un compte créé manuellement plus tard (non exposé à cette
  // phase, mais le champ existe pour ne pas distinguer les deux origines
  // après coup si un écran de création manuelle est ajouté).
  systemDefined Boolean           @default(true)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())

  lines JournalLine[]
  comptesTresorerie TresorerieCompte[]

  @@unique([scope, shopId, code])
  @@index([scope, shopId])
}

// Business plan et scénarios de prêt (16 oct. 2026). Reprend le patron déjà
// validé pour FiscalRule/Account : un seul jeu de modèles, séparé par scope
// (SHOP/PLATFORM) + shopId nullable, isolation imposée côté service/contrôleur
// (jamais seulement par l'affichage). scope=SHOP, shopId défini → business
// plan d'une boutique ; scope=PLATFORM, shopId=null → business plan
// d'ELEGANZ elle-même en tant que société (singleton applicatif : le service
// vérifie toujours l'existence avant création, Postgres n'empêche pas à lui
// seul plusieurs lignes à shopId NULL sur un index unique nullable).
// Alimente le dossier crédit (boutique et plateforme) et le futur rapport
// annuel (section business plan / perspectives).
model BusinessPlan {
  id                  String          @id @default(uuid())
  scope               FiscalRuleScope
  shopId              String?
  shop                Shop?           @relation(fields: [shopId], references: [id])
  resumeExecutif      String?         @db.Text
  descriptionActivite String?         @db.Text
  marcheEtClientele   String?         @db.Text
  strategieCroissance String?         @db.Text
  utilisationFonds    String?         @db.Text
  risquesMitigation   String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  scenarios LoanScenario[]

  @@unique([scope, shopId])
}

// Scénario de sollicitation de prêt attaché à un business plan (boutique ou
// plateforme). Plusieurs scénarios peuvent coexister (ex. "Expansion
// stock" vs "Equipement logistique") ; chacun porte son propre montant,
// taux et durée pour comparer plusieurs hypothèses de financement.
model LoanScenario {
  id               String       @id @default(uuid())
  businessPlanId   String
  businessPlan     BusinessPlan @relation(fields: [businessPlanId], references: [id], onDelete: Cascade)
  label            String
  montant          Decimal      @db.Decimal(14, 2)
  tauxAnnuel       Decimal      @db.Decimal(5, 2)
  dureeMois        Int
  objetFinancement String?
  createdAt        DateTime     @default(now())

  @@index([businessPlanId])
}

enum JournalEntrySource {
  POS_SALE
  SHOP_ORDER
  EXPENSE
  PURCHASE
  INVOICE
  MANUAL
  DEPRECIATION
  // Ajouté le 14 oct. 2026 — module Trésorerie multi-comptes (chantier
  // SYSCOHADA, phase 2). Mouvement manuel sur un compte TresorerieCompte
  // (dépôt, retrait, virement, frais bancaires) — jamais un doublon d'une
  // écriture déjà posée par une autre règle (vente, achat, charge...).
  TRESORERIE_MOUVEMENT
  // Ajouté le 14 oct. 2026 — chantier SYSCOHADA phase 4b (stock & CMV).
  // Écriture SÉPARÉE de POS_SALE pour la même vente (même sourceId=sale.id,
  // sourceType différent) : constate la sortie de stock au CUMP (603/311),
  // distincte de l'écriture caisse/ventes déjà posée par postPosSale — une
  // même sourceType+sourceId pour les deux aurait fait ignorer la seconde
  // comme "déjà comptabilisée" via la contrainte d'unicité existante.
  COGS_VENTE
}

model Journal {
  id     String          @id @default(uuid())
  scope  FiscalRuleScope
  shopId String?
  shop   Shop?           @relation(fields: [shopId], references: [id])
  code   String // VE (ventes), AC (achats), TR (trésorerie), OD (opérations diverses)
  label  String

  entries JournalEntry[]

  @@unique([scope, shopId, code])
}

model JournalEntry {
  id         String             @id @default(uuid())
  scope      FiscalRuleScope
  shopId     String?
  shop       Shop?              @relation(fields: [shopId], references: [id])
  journalId  String
  journal    Journal            @relation(fields: [journalId], references: [id])
  entryDate  DateTime
  label      String
  sourceType JournalEntrySource
  // id de PosSale/ShopOrder/Expense/Purchase/Invoice à l'origine de
  // l'écriture ; null pour une écriture MANUAL. Sert de garde-fou anti
  // double-comptabilisation via l'unicité ci-dessous (NULL n'entre jamais en
  // conflit avec un index unique Postgres, donc les écritures MANUAL ne se
  // bloquent jamais entre elles).
  sourceId   String?
  createdAt  DateTime           @default(now())

  lines JournalLine[]

  @@unique([scope, shopId, sourceType, sourceId])
  @@index([scope, shopId, entryDate])
}

model JournalLine {
  id        String       @id @default(uuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id])
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Decimal      @default(0) @db.Decimal(12, 2)
  credit    Decimal      @default(0) @db.Decimal(12, 2)
  label     String?

  @@index([entryId])
  @@index([accountId])
}

// Trésorerie multi-comptes (14 oct. 2026, chantier SYSCOHADA réactivé,
// phase 2) — voir Doc "Finance & Comptabilité SYSCOHADA — Audit & plan
// d'intégration", tabs D/E. Chaque compte réel (une banque, un opérateur
// mobile money) a son propre sous-compte de grand livre (classe 521 ou
// 532), créé automatiquement à la création du TresorerieCompte — jamais
// partagé entre deux comptes réels, pour permettre un rapprochement
// bancaire compte par compte.
enum TresorerieCompteType {
  BANQUE
  MOBILE_MONEY
}

model TresorerieCompte {
  id        String               @id @default(uuid())
  scope     FiscalRuleScope
  shopId    String?
  shop      Shop?                @relation(fields: [shopId], references: [id])
  type      TresorerieCompteType
  label     String // ex. "Equity BCDC — compte courant USD"
  numero    String? // numéro de compte ou numéro de ligne mobile money
  devise    String               @default("USD")
  accountId String // sous-compte dédié dans Account (classe 521/532)
  account   Account              @relation(fields: [accountId], references: [id])
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())

  rapprochements Rapprochement[]

  @@index([scope, shopId])
}

// Rapprochement bancaire : un constat ponctuel (solde du relevé vs solde
// comptable à une date), pas un appariement ligne à ligne à cette phase —
// ce serait présenter comme construit un rapprochement automatique qui
// n'existe pas réellement.
model Rapprochement {
  id             String           @id @default(uuid())
  compteId       String
  compte         TresorerieCompte @relation(fields: [compteId], references: [id])
  dateReleve     DateTime
  soldeReleve    Decimal          @db.Decimal(12, 2)
  soldeComptable Decimal          @db.Decimal(12, 2)
  ecart          Decimal          @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime         @default(now())
  createdBy      String?

  @@index([compteId, dateReleve])
}

// Immobilisations et amortissements (13 oct. 2026, Finance & Comptabilité
// Phase 4) — voir docs/ARCHITECTURE_FINANCE.md §8quater. Amortissement
// linéaire uniquement à cette phase (le seul mode réellement demandé).
// Comptabilisé via AccountingService (compte 681 débité / 2841 crédité),
// jamais calculé ici directement.
model Asset {
  id               String    @id @default(uuid())
  scope            FiscalRuleScope
  shopId           String?
  shop             Shop?     @relation(fields: [shopId], references: [id])
  label            String
  acquisitionDate  DateTime
  acquisitionCost  Decimal   @db.Decimal(12, 2)
  currency         String    @default("USD")
  // Durée d'amortissement en mois (ex. 60 pour 5 ans) — pas de table de
  // durées réglementaires par catégorie à cette phase, saisie libre par
  // l'utilisateur.
  durationMonths   Int
  disposed         Boolean   @default(false)
  disposedAt       DateTime?
  createdAt        DateTime  @default(now())

  depreciations AssetDepreciation[]

  @@index([scope, shopId])
}

// Une ligne par mois réellement comptabilisé pour un actif donné — la clé
// `[assetId, periodDate]` est composite mais SANS champ nullable (contrairement
// à l'incident déjà documenté dans MAINTENANCE.md), donc utilisable sans
// risque dans `findUnique`/`upsert` si besoin plus tard.
model AssetDepreciation {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])
  periodDate DateTime
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@unique([assetId, periodDate])
}

// Assistant de clôture de période (13 oct. 2026, Finance & Comptabilité
// Phase 5) — voir docs/ARCHITECTURE_FINANCE.md §8quinquies. La présence
// d'une ligne pour `[scope, shopId, periodDate]` verrouille ce mois : toute
// tentative d'écriture (AccountingService.enregistrer) dont la date tombe
// dans un mois clôturé est refusée. `@@unique` ici sert uniquement de
// garde-fou en base (vérifié par `findFirst` + `create`, jamais par
// `findUnique`/`upsert` sur la clé composite — leçon déjà documentée dans
// MAINTENANCE.md) : le champ `shopId` nullable ne pose donc aucun risque.
model AccountingClosure {
  id          String   @id @default(uuid())
  scope       FiscalRuleScope
  shopId      String?
  shop        Shop?    @relation(fields: [shopId], references: [id])
  periodDate  DateTime
  closedAt    DateTime @default(now())
  closedBy    String?
  totalDebit  Decimal  @db.Decimal(12, 2)
  totalCredit Decimal  @db.Decimal(12, 2)
  resultatNet Decimal  @db.Decimal(12, 2)

  @@unique([scope, shopId, periodDate])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS & MESSAGERIE — fondations transverses (15 oct. 2026, demande
// UX points 4 et 7). Portée volontairement minimale pour cette phase :
// in-app uniquement (voir PlatformSettings.notifications*Enabled ci-dessus),
// pas d'envoi temps réel (websocket) — la liste se rafraîchit par polling
// côté client, comme le reste de la plateforme (aucune socket existante).
// ---------------------------------------------------------------------------

enum NotificationType {
  COMMANDE_RECUE // nouvelle sous-commande reçue par une boutique
  NOUVEAU_MESSAGE // nouveau message dans une conversation
  ECHEANCE_A_VENIR // relance avant échéance (chantier C, à venir)
  ECHEANCE_DEPASSEE // relance après échéance (chantier C, à venir)
  AUTRE
}

// Canal sur lequel CETTE notification a été (ou aurait dû être) envoyée —
// permet de respecter l'interrupteur par canal de PlatformSettings même
// si plusieurs canaux sont activés plus tard pour un même événement.
enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  // Chemin relatif cliquable dans l'app (ex. "/commandes/<id>") — jamais une
  // URL absolue, pour rester indépendant du domaine (admin/gestion/market).
  link      String?
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Messagerie interne (point 4) — volontairement générique : une conversation
// peut être liée à une boutique (support boutique <-> ELEGANZ, ou boutique
// <-> acheteur plus tard) ou rester libre (shopId nul). Pas de notion de
// "ticket" ou de statut à cette phase — seulement un fil de messages.
model Conversation {
  id        String   @id @default(uuid())
  subject   String?
  shopId    String?
  shop      Shop?    @relation(fields: [shopId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  // Dernière lecture par CET utilisateur — sert à calculer le nombre de
  // messages non lus sans table de lecture séparée par message.
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
