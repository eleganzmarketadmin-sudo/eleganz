{
  "name": "eleganz",
  "private": true,
  "version": "0.0.1",
  "description": "ELEGANZ — plateforme Gestion + Marketplace (RDC)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:api": "pnpm --filter @eleganz/api dev",
    "dev:web": "pnpm --filter @eleganz/web dev",
    "db:generate": "pnpm --filter @eleganz/database generate"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.5.0",
      "lodash": ">=4.18.0",
      "image-size": ">=2.0.3",
      "picomatch": ">=4.0.4",
      "glob@^10": ">=10.5.0",
      "tmp": ">=0.2.6",
      "postcss": ">=8.5.23",
      "body-parser": ">=1.20.9",
      "qs": ">=6.16.1",
      "uuid": ">=11.1.1",
      "minimatch": ">=11.0.1",
      "file-type": ">=21.3.2"
    }
  }
}
